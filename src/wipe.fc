// Screen wipes (f_wipe.c): the melt between game states. Ported from
// linuxdoom-1.10 (GPLv2).

module wipe =
    let color_xform = 0
    let melt = 1

    let mut go = false
    let mut wipe_scr_start = default(u8*)
    let mut wipe_scr_end = default(u8*)
    let mut wipe_scr = default(u8*)
    let mut ycols = default(i32[])

    let init_color_xform = (width: i32, height: i32, ticks: i32) ->
        c.memcpy((any*) wipe_scr, (const any*) wipe_scr_start, (i64) v.sw * v.sh)

    let do_color_xform = (width: i32, height: i32, ticks: i32) ->
        let mut changed = false
        for k in 0..v.sw * v.sh do
            let wv = (i32) *(wipe_scr + k)
            let ev = (i32) *(wipe_scr_end + k)
            if wv != ev then
                if wv > ev then
                    let newval = wv - ticks
                    *(wipe_scr + k) = if newval < ev then (u8) ev else (u8) newval
                    changed = true
                else if wv < ev then
                    let newval = wv + ticks
                    *(wipe_scr + k) = if newval > ev then (u8) ev else (u8) newval
                    changed = true
        !changed

    // The melt runs on Doom's 320x200 grid: 160 two-pixel columns, each
    // with a 0..200 drop. ycols is in those rows; each column is drawn over
    // its 2 * hires screen pixels, each drop row over hy screen rows. (The original sliced the screen into
    // shorts in column-major order; drawing each column from its drop
    // gives the same frames.)
    let init_melt = (width: i32, height: i32, ticks: i32) ->
        // copy start screen to main screen
        c.memcpy((any*) wipe_scr, (const any*) wipe_scr_start, (i64) v.sw * v.sh)
        // setup initial column positions
        // (y<0 => not ready to scroll yet). Like the original this draws
        // `width` positions though the melt uses only the first half,
        // which keeps M_Random's sequence.
        if ycols.len < width then ycols = alloc(i32[] { len = width })!
        ycols[0] = 0 - (rnd.m_random() % 16)
        for k in 1..width do
            let rr = (rnd.m_random() % 3) - 1
            ycols[k] = ycols[k - 1] + rr
            if ycols[k] > 0 then ycols[k] = 0
            else if ycols[k] == -16 then ycols[k] = -15

    // Redraw melt column k: the end screen above its drop, the start
    // screen shifted down below it.
    let draw_melt_column = (k: i32, drop: i32) ->
        let n = v.hires
        let pitch = v.sw
        let x0 = k * 2 * n
        let cw = 2 * n
        let split = drop * v.hy
        for y in 0..v.sh do
            let dest = wipe_scr + y * pitch + x0
            let src = if y < split then wipe_scr_end + y * pitch + x0
                      else wipe_scr_start + (y - split) * pitch + x0
            c.memcpy((any*) dest, (const any*) src, (i64) cw)

    let do_melt = (width: i32, height: i32, ticks0: i32) ->
        let mut done = true
        let cols = width / 2
        let mut ticks = ticks0
        loop
            if ticks <= 0 then break
            ticks = ticks - 1
            for k in 0..cols do
                if ycols[k] < 0 then
                    ycols[k] = ycols[k] + 1
                    done = false
                else if ycols[k] < height then
                    let mut dy = if ycols[k] < 16 then ycols[k] + 1 else 8
                    if ycols[k] + dy >= height then dy = height - ycols[k]
                    ycols[k] = ycols[k] + dy
                    draw_melt_column((i32) k, ycols[k])
                    done = false
        done

    let start_screen = (x: i32, y: i32, width: i32, height: i32) ->
        wipe_scr_start = v.screens[2]
        iv.read_screen(wipe_scr_start)

    let end_screen = (x: i32, y: i32, width: i32, height: i32) ->
        wipe_scr_end = v.screens[3]
        iv.read_screen(wipe_scr_end)
        v.copy_screen(2, 0)    // restore start scr.

    let screen_wipe = (wipeno: i32, x: i32, y: i32, width: i32, height: i32, ticks: i32) ->
        // initial stuff
        if !go then
            go = true
            wipe_scr = v.screens[0]
            if wipeno == melt then init_melt(width, height, ticks)
            else init_color_xform(width, height, ticks)
        // do a piece of wipe-in
        v.mark_rect(0, 0, width, height)
        let rc = if wipeno == melt then do_melt(width, height, ticks) else do_color_xform(width, height, ticks)
        // final stuff
        if rc then go = false
        !go
