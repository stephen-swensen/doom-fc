// v_video (software 2D drawing into the 8-bit screens) and i_video (the
// SDL2 host: window, palette, frame upload, input translation). v_video is
// ported from linuxdoom-1.10 (GPLv2); i_video replaces the X11 original
// with SDL2.
//
// The screens are `hires` times 320 wide and `hy` times 200 tall. Every 2D
// caller (status bar, menus, intermission, HUD text) still works in Doom's
// 320x200 coordinates; the drawers here scale them up. Only the 3D
// renderer, the automap and the wipe work in screen pixels.
//
// Normally hy == hires and SDL stretches the frame to 4:3, as a VGA
// monitor stretched 320x200. In native 4:3 mode (`native`, offered when
// hires is a multiple of 5) hy is hires * 6/5: the screens already have
// square pixels (1600x1200 at 5x), every 2D pixel is a whole 5x6 block,
// and the presentation is a 1:1 copy.

// A patch_t header; the column offset table follows at byte 8.
struct patch =
    width: i16
    height: i16
    leftoffset: i16
    topoffset: i16

module patches =
    let column_ofs = (p: const patch*, col: i32) ->
        *((const i32*) ((const u8*) p + 8) + col)
    let column = (p: const patch*, col: i32) ->
        (const u8*) p + column_ofs(p, col)

module v =
    // Doom's 2D coordinate space.
    let basew = 320
    let baseh = 200

    // Screen pixels per 2D unit across (hires) and down (hy), and the
    // screen size that gives.
    let mut hires = 1
    let mut hy = 1
    let mut native = false
    let mut sw = 320
    let mut sh = 200

    // screens[0] is the visible frame, 1 is the wipe/background copy,
    // 2-3 wipe scratch, 4 the status bar background.
    let mut screens = default(u8*[])
    let mut dirtybox = i32[] { len = 4 }

    let gamma = (level: i32, v: u8) -> gammatbl.table[level * 256 + (i32) v]

    let init = () -> set_hires(1, false)

    // Native 4:3 needs a whole number of rows per 2D row.
    let native_ok = (n: i32) -> n % 5 == 0

    // (Re)allocate the screens at factor `n` (native 4:3 or not), cleared
    // to black. Callers above this layer redraw whatever lived in them
    // (see d.apply_hires).
    let set_hires = (n: i32, nat: bool) ->
        if screens.len == 0 then screens = alloc(u8*[] { len = 5 })!
        else for k in 0..5 do free(screens[k])
        hires = n
        native = nat && native_ok(n)
        hy = if native then n * 6 / 5 else n
        sw = basew * n
        sh = baseh * hy
        for k in 0..5 do
            screens[k] = alloc(u8, (i64) sw * sh)!

    let mark_rect = (x: i32, y: i32, width: i32, height: i32) ->
        box.add(dirtybox, x, y)
        box.add(dirtybox, x + width - 1, y + height - 1)

    let copy_rect = (srcx: i32, srcy: i32, srcscrn: i32, width: i32, height: i32,
                     destx: i32, desty: i32, destscrn: i32) ->
        if srcx < 0 || srcx + width > basew || srcy < 0 || srcy + height > baseh
            || destx < 0 || destx + width > basew || desty < 0 || desty + height > baseh
            || srcscrn < 0 || srcscrn > 4 || destscrn < 0 || destscrn > 4 then
            i.fatal("Bad V_CopyRect")
        mark_rect(destx, desty, width, height)
        let n = hires
        let mut src = screens[srcscrn] + sw * srcy * hy + srcx * n
        let mut dest = screens[destscrn] + sw * desty * hy + destx * n
        for _ in 0..height * hy do
            mem.memcpy((any*) dest, (const any*) src, (i64) width * n)
            src = src + sw
            dest = dest + sw

    // One patch column, its top at 2D row y, into 2D column x. Each source
    // pixel becomes a hires x hy block.
    let draw_patch_column = (x: i32, y: i32, scrn: i32, p: const patch*, col: i32) ->
        let n = hires
        let ny = hy
        let pitch = sw
        let desttop = screens[scrn] + y * ny * pitch + x * n
        let mut column = patches.column(p, col)
        loop
            let topdelta = *column
            if topdelta == 0xffu8 then break
            let length = (i32) *(column + 1)
            let mut source = column + 3
            let mut dest = desttop + (i32) topdelta * ny * pitch
            if n == 1 && ny == 1 then
                for _ in 0..length do
                    *dest = *source
                    source = source + 1
                    dest = dest + pitch
            else
                for _ in 0..length do
                    let px = *source
                    for _ in 0..ny do
                        for k in 0..n do *(dest + k) = px
                        dest = dest + pitch
                    source = source + 1
            column = column + length + 4

    // V_DrawPatch: column-masked patch, clipped by rejection.
    let draw_patch_flip = (x0: i32, y0: i32, scrn: i32, p: const patch*, flipped: bool) ->
        let y = y0 - p.topoffset
        let x = x0 - p.leftoffset
        let w = (i32) p.width
        if x < 0 || x + w > basew || y < 0 || y + p.height > baseh || scrn < 0 || scrn > 4 then
            // linuxdoom only warns here ("what is up with TNT.WAD?")
            void()
        else
            if scrn == 0 then mark_rect(x, y, w, (i32) p.height)
            for col in 0..w do
                draw_patch_column(x + col, y, scrn, p, if flipped then w - 1 - col else col)

    let draw_patch = (x: i32, y: i32, scrn: i32, p: const patch*) ->
        draw_patch_flip(x, y, scrn, p, false)

    let draw_patch_flipped = (x: i32, y: i32, scrn: i32, p: const patch*) ->
        draw_patch_flip(x, y, scrn, p, true)

    let draw_patch_direct = (x: i32, y: i32, scrn: i32, p: const patch*) ->
        draw_patch(x, y, scrn, p)

    // Tile a 64x64 flat over a 2D rectangle (the finale text background,
    // the border around a reduced view).
    let fill_flat = (x: i32, y: i32, width: i32, height: i32, scrn: i32, flat: const u8*) ->
        let n = hires
        let ny = hy
        let x0 = x * n
        let x1 = (x + width) * n
        unguarded
            for py in y * ny..(y + height) * ny do
                let src = flat + (((py / ny) & 63) << 6)
                let dest = screens[scrn] + py * sw
                if n == 1 then
                    for px in x0..x1 do *(dest + px) = *(src + (px & 63))
                else
                    for px in x0..x1 do *(dest + px) = *(src + ((px / n) & 63))

    // Copy a whole screen.
    let copy_screen = (srcscrn: i32, destscrn: i32) ->
        mem.memcpy((any*) screens[destscrn], (const any*) screens[srcscrn], (i64) sw * sh)

    // Patch lookup by lump name, cached.
    let patch_named = (name: const str) ->
        (const patch*) w.cache_lump_name(name, pu.cache)

    let patch_named_mut = (name: const str) ->
        (patch*) w.cache_lump_name(name, pu.static_x)

    let patch_num = (lump: i32) ->
        (const patch*) w.cache_lump_num(lump, pu.cache)

// i_video: SDL2 window + input
module iv =
    import text from std::

    let mut window = default(any*)    // (unused headless)
    let mut renderer = default(any*)
    let mut texture = none(any*)    // made by the first sync_texture
    let mut pixels = default(u32[])
    let mut palette = u32[] { len = 256 }
    let mut headless = false
    let mut fullscreen = false
    let mut grabmouse = true
    let mut mouse_grabbed = false
    let mut novert = true

    // ------------------------------------------------------------------
    // Render scale (wolf-fc's Scale Factor). The game renders at v.hires
    // times 320x200; SDL then stretches that to 4:3 (the 1.2 pixel aspect)
    // and letterboxes it into the drawable. Or, in native 4:3, it renders
    // square pixels at hires times 320x240 and SDL only copies it.
    //
    // A scale preference is a code: 0 is Auto, the largest factor whose
    // 4:3 output fits the drawable in both axes, capped at max_scale, and
    // native whenever that factor allows it. 1..12 pins a stretched
    // factor (ignoring the cap), and native_code + N pins native N.
    // ------------------------------------------------------------------

    let max_factor = 12
    let native_code = 100
    let mut scale_factor = 0       // the "scale_factor" config entry
    let mut scale_override = -1    // -scale N (or Nn, native): this session only
    let mut max_scale = 6          // -maxscale N
    let mut want_hires = 1         // applied at a frame boundary by d.apply_hires
    let mut want_native = false
    let mut drawable_w = 0
    let mut drawable_h = 0
    let mut refresh_hz = 0
    // Frame interpolation (set by d): a frame per display refresh rather
    // than per tic. Present() normally waits for vsync, but a renderer can
    // claim vsync and not wait (SDL's dummy driver does), so finish_update
    // also holds each frame to 3/4 of a refresh period: with real vsync
    // the present still lands on the next refresh, and without it the
    // game draws at 4/3 the refresh rate instead of spinning.
    let mut frame_interp = false
    let mut last_present_us = 0i64
    // Texture pixels per screen pixel. When the render factor is below
    // what the drawable could take (a pinned low factor, or the max_scale
    // cap), the frame is replicated in software up to that size, so SDL's
    // linear stretch stays sharp.
    let mut present = 1
    let mut tex_w = 0
    let mut tex_h = 0
    let mut tex_native = false

    // The largest integer factor whose 4:3 output fits out_w x out_h.
    let fit_factor = (out_w: i32, out_h: i32) ->
        if out_w <= 0 || out_h <= 0 then 1
        else
            let sw = out_w / v.basew
            let sh = out_h / (v.baseh * 6 / 5)
            let s = if sw < sh then sw else sh
            if s < 1 then 1 else if s > max_factor then max_factor else s

    let effective_pref = () -> if scale_override >= 0 then scale_override else scale_factor

    // A code from the config or the command line, made valid.
    let clamp_code = (code: i32) ->
        let nat = code >= native_code
        let n0 = if nat then code - native_code else code
        let n = if n0 < 0 then 0 else if n0 > max_factor then max_factor else n0
        if nat && n > 0 && v.native_ok(n) then native_code + n else n

    let pick_hires = () ->
        let pref = clamp_code(effective_pref())
        if pref > 0 then pref % native_code
        else if headless then 1
        else
            let s = fit_factor(drawable_w, drawable_h)
            if s > max_scale then max_scale else s

    // Re-pick after a drawable or preference change.
    let repick = () ->
        want_hires = pick_hires()
        let pref = clamp_code(effective_pref())
        want_native = if pref == 0 then v.native_ok(want_hires) else pref >= native_code

    // The picker's order: Auto, 1X .. 12X, each native factor right after
    // its stretched one.
    let next_code = (code0: i32, dir: i32) ->
        let codes = i32[] { len = 2 * max_factor + 1 }
        let mut n = 0
        codes[n] = 0
        n = n + 1
        for f in 1..max_factor + 1 do
            codes[n] = f
            n = n + 1
            if v.native_ok(f) then
                codes[n] = native_code + f
                n = n + 1
        let code = clamp_code(code0)
        let mut at = 0
        for k in 0..n do
            if codes[k] == code then at = k
        codes[(at + dir + n) % n]

    // A code's factor, and its label suffix after "5X".
    let code_factor = (code: i32) -> code % native_code
    let code_suffix = (code: i32) -> if code >= native_code then " 4:3" else ""

    let query_display = () ->
        let mut ow = 0
        let mut oh = 0
        ignore sdl2.get_output_size(renderer, &ow, &oh)
        drawable_w = ow
        drawable_h = oh
        let disp = sdl2.window_display_index(window)
        let mut mode = default(sdl_display_mode)
        refresh_hz = if disp >= 0 && sdl2.current_display_mode(disp, (any*) &mode) == 0 then mode.refresh_rate else 0

    let init_graphics = () ->
        let pm = argv.check_parm("-maxscale")
        if pm > 0 && pm < argv.count() - 1 then
            let n = argv.int_after(pm)
            max_scale = if n < 1 then 1 else if n > max_factor then max_factor else n
        let ps = argv.check_parm("-scale")
        if ps > 0 && ps < argv.count() - 1 then
            let arg = argv.get(ps + 1)
            let nat = arg.len > 0 && (arg[arg.len - 1] == 'n' || arg[arg.len - 1] == 'N')
            let digits = if nat then arg[0..arg.len - 1] else arg
            let n = match text.parse_i32(digits) with
                | ok(v0) -> v0
                | err(_) ->
                    i.fatal(alloca("Bad -scale argument: %s{arg}"))
                    0
            scale_override = clamp_code(if nat then native_code + n else n)
        if argv.check_parm("-debug") > 0 then dbg_on = true
        if headless then
            repick()
        else
            // audio is brought up separately, by isnd.init
            if sdl2.init(sdl2.init_video) != 0 then
                i.fatal(alloca("SDL_Init failed: %s{(const str) sdl2.get_error()}"))
            ignore sdl2.set_hint(c"SDL_RENDER_SCALE_QUALITY", c"linear")
            let flags = sdl2.window_resizable | sdl2.window_allow_highdpi
                | (if argv.check_parm("-fullscreen") > 0 then sdl2.window_fullscreen_desktop else 0u32)
            fullscreen = argv.check_parm("-fullscreen") > 0
            let win = sdl2.create_window(c"doom-fc", sdl2.pos_centered, sdl2.pos_centered, 960, 720, flags)
            if win.is_none then i.fatal("SDL_CreateWindow failed")
            window = win!
            let mut ren = sdl2.create_renderer(window, -1, sdl2.renderer_accel | sdl2.renderer_vsync)
            if ren.is_none then ren = sdl2.create_renderer(window, -1, sdl2.renderer_sw)
            if ren.is_none then i.fatal("SDL_CreateRenderer failed")
            renderer = ren!
            ignore sdl2.show_cursor(0)
            if argv.check_parm("-nomouse") > 0 then grabmouse = false
            if argv.check_parm("-mousemove") > 0 then novert = false
            query_display()
            repick()
            let how = if want_native then " native 4:3" else ""
            i.print(alloca("I_InitGraphics: drawable %d{drawable_w}x%d{drawable_h} at %d{refresh_hz} Hz, render scale %d{want_hires}x%s{how}\n"))

    // Match the streaming texture to the screens and the drawable.
    let sync_texture = () ->
        let fit = fit_factor(drawable_w, drawable_h)
        let mut k = fit / v.hires
        if k < 1 then k = 1
        let w = v.sw * k
        let h = v.sh * k
        // set even when the size holds: 640x400 at k=2 and 1280x800 at k=1
        // share a texture, and finish_update replicates by `present`
        present = k
        if w != tex_w || h != tex_h || v.native != tex_native then
            match texture with
            | some(t) -> sdl2.destroy_texture(t)
            | none -> void()
            if pixels.len > 0 then free(pixels)
            tex_w = w
            tex_h = h
            tex_native = v.native
            texture = sdl2.create_texture(renderer, sdl2.pixel_argb8888, sdl2.tex_streaming, w, h)
            pixels = alloc(u32[] { len = (i64) w * h })!
            // native screens are already 4:3
            ignore sdl2.set_logical_size(renderer, w, if v.native then h else h * 6 / 5)
            dbg_reset()

    // I_ShutdownGraphics. Not SDL_Quit: that also closes the audio device,
    // which joins the audio thread and hangs forever if the sound server
    // has wedged it (see isnd). The OS reaps the rest at exit.
    let shutdown_graphics = () ->
        if !headless then
            match texture with
            | some(t) -> sdl2.destroy_texture(t)
            | none -> void()
            sdl2.destroy_renderer(renderer)
            sdl2.destroy_window(window)

    // I_SetPalette: 768 bytes of RGB, gamma-corrected through usegamma.
    let set_palette = (pal: const u8*) ->
        for k in 0..256 do
            let r = (u32) v.gamma(ds.usegamma, *(pal + k * 3))
            let g = (u32) v.gamma(ds.usegamma, *(pal + k * 3 + 1))
            let b = (u32) v.gamma(ds.usegamma, *(pal + k * 3 + 2))
            palette[k] = 0xff000000u32 | (r << 16) | (g << 8) | b

    // The current frame as ARGB, v.sw x v.sh (for screenshots).
    let frame_argb = (out: u32[]) ->
        let src = v.screens[0]
        unguarded
            for k in 0..v.sw * v.sh do out[k] = palette[(i32) *(src + k)]

    let set_grab = (want: bool) ->
        if !headless && want != mouse_grabbed then
            ignore sdl2.set_relative_mouse_mode(if want then 1 else 0)
            mouse_grabbed = want

    // I_FinishUpdate
    let finish_update = () ->
        if headless then void()
        else
            sync_texture()
            let src = v.screens[0]
            let sw = v.sw
            let sh = v.sh
            let k = present
            let pw = tex_w
            unguarded
                if k == 1 then
                    for j in 0..sw * sh do pixels[j] = palette[(i32) *(src + j)]
                else
                    for y in 0..sh do
                        let row = src + y * sw
                        let base = y * k * pw
                        for x in 0..sw do
                            let px = palette[(i32) *(row + x)]
                            let o = base + x * k
                            for j in 0..k do pixels[o + j] = px
                        for rr in 1..k do
                            mem.memcpy((any*) (pixels.ptr + base + rr * pw), (const any*) (pixels.ptr + base), (i64) pw * 4)
            if dbg_on then dbg_draw()
            // (sync_texture just made the texture, or SDL had no memory)
            let tex = texture!
            ignore sdl2.update_texture(tex, none(const sdl2.rect*), (const any*) pixels.ptr, pw * 4)
            ignore sdl2.set_color(renderer, 0u8, 0u8, 0u8, 255u8)
            ignore sdl2.clear(renderer)
            ignore sdl2.render_copy(renderer, tex, none(const sdl2.rect*), none(const sdl2.rect*))
            dbg_mark_work_end()
            if frame_interp then
                let hz = if refresh_hz > 0 then refresh_hz else 60
                let due = last_present_us + 750000i64 / (i64) hz
                loop
                    let left = due - i.get_time_us()
                    if left <= 0i64 then break
                    if left > 1500i64 then i.sleep_ms(1) else void()
                last_present_us = i.get_time_us()
            sdl2.present(renderer)
            dbg_frame_presented()

    let read_screen = (dest: u8*) ->
        mem.memcpy((any*) dest, (const any*) v.screens[0], (i64) v.sw * v.sh)

    // ------------------------------------------------------------------
    // Debug overlay (-debug, or the ` key): frame rate, per-frame work
    // against the 35 Hz tic budget, dropped tics, presentation jitter, and
    // the render / output geometry. Drawn into the upload buffer after the
    // frame is converted, so it never lands in screenshots, and never in
    // -headless runs.
    // ------------------------------------------------------------------

    let tic_ms = 1000.0 / 35.0
    let mut dbg_on = false
    let mut dbg_work_start = 0i64
    let mut dbg_work_us = 0i64
    let mut dbg_last_present = 0i64
    let mut dbg_ms = 0.0            // EMA of the displayed-frame period
    let mut dbg_work_ms = 0.0       // EMA of the work before present()
    let mut dbg_jitter_ms = 0.0     // EMA of |period - tic|
    let mut dbg_drops = 0           // tics run without being displayed
    let mut dbg_hitch = 0           // frames left to show the hitch colour
    let mut dbg_font = default((const patch*?)[])

    let dbg_reset = () ->
        dbg_ms = 0.0
        dbg_work_ms = 0.0
        dbg_jitter_ms = 0.0
        dbg_drops = 0
        dbg_hitch = 0
        dbg_last_present = 0i64

    // Called once the frame's tics are due, before they run.
    let dbg_mark_work_start = () -> dbg_work_start = i.get_time_us()

    // TryRunTics ran `n` tics for this frame; all but one go unseen.
    let dbg_tics_run = (n: i32) ->
        if n > 1 && dbg_last_present > 0i64 then
            dbg_drops = dbg_drops + n - 1
            dbg_hitch = 18

    let dbg_mark_work_end = () ->
        dbg_work_us = i.get_time_us() - dbg_work_start

    // The frame period presentation aims for: a tic, or a display refresh
    // with frame interpolation.
    let frame_ms = () ->
        if frame_interp && refresh_hz > 0 then 1000.0 / (f64) refresh_hz else tic_ms

    let dbg_frame_presented = () ->
        let now = i.get_time_us()
        let work = (f64) dbg_work_us / 1000.0
        dbg_work_ms = if dbg_work_ms > 0.0 then dbg_work_ms * 0.9 + work * 0.1 else work
        if dbg_last_present > 0i64 then
            let ms = (f64) (now - dbg_last_present) / 1000.0
            let target = frame_ms()
            let dev = if ms > target then ms - target else target - ms
            dbg_jitter_ms = if dbg_ms > 0.0 then dbg_jitter_ms * 0.9 + dev * 0.1 else dev
            dbg_ms = if dbg_ms > 0.0 then dbg_ms * 0.9 + ms * 0.1 else ms
        dbg_last_present = now
        if dbg_hitch > 0 then dbg_hitch = dbg_hitch - 1

    let toggle_debug = () ->
        dbg_on = !dbg_on
        dbg_reset()

    // The HUD font (STCFN033..STCFN095), straight from the WAD.
    let dbg_glyph = (ch0: i32) ->
        if dbg_font.len == 0 then
            dbg_font = alloc((const patch*?)[] { len = 64 })!
            for k in 0..63 do
                let lump = w.check_num_for_name(alloca("STCFN%03d{k + 33}"))
                if lump >= 0 then dbg_font[k] = some(v.patch_num(lump))
        let ch = if ch0 >= 'a' && ch0 <= 'z' then ch0 - 'a' + 'A' else ch0
        if ch < 33 || ch > 95 then none(const patch*) else dbg_font[ch - 33]

    // One glyph at texture pixel (x, y), each font pixel an s x s block:
    // in the font's own red when `red`, else as grey of the same
    // brightness. Returns the advance.
    let dbg_char = (x: i32, y0: i32, ch: i32, red: bool, s: i32) ->
        let p = match dbg_glyph(ch) with
        | some(g) -> g
        | none -> return 4 * s
        let pw = tex_w
        let y = y0 - (i32) p.topoffset * s
        for col in 0..(i32) p.width do
            let mut column = patches.column(p, col)
            loop
                let topdelta = (i32) *column
                if topdelta == 0xff then break
                let length = (i32) *(column + 1)
                for row in topdelta..topdelta + length do
                    let c0 = palette[(i32) *(column + 3 + (row - topdelta))]
                    let r = (c0 >> 16) & 0xffu32
                    let g = (c0 >> 8) & 0xffu32
                    let b = c0 & 0xffu32
                    let hi = if r > g && r > b then r else if g > b then g else b
                    let grey = if hi * 3u32 / 2u32 > 255u32 then 255u32 else hi * 3u32 / 2u32
                    let color = if red then c0 else 0xff000000u32 | (grey << 16) | (grey << 8) | grey
                    for sy in 0..s do
                        let py = y + row * s + sy
                        if py >= 0 && py < tex_h then
                            for sx in 0..s do
                                let px = x + col * s + sx
                                if px >= 0 && px < pw then pixels[py * pw + px] = color
                column = column + length + 4
        ((i32) p.width + 1) * s

    let dbg_text_width = (text: const str, s: i32) ->
        let mut wd = 0
        for ch in text do
            wd = wd + match dbg_glyph((i32) ch) with
            | some(p) -> ((i32) p.width + 1) * s
            | none -> 4 * s
        wd

    // Darken a texture rectangle behind the text.
    let dbg_dim = (x0: i32, y0: i32, x1: i32, y1: i32) ->
        for y in y0..y1 do
            if y >= 0 && y < tex_h then
                for x in x0..x1 do
                    if x >= 0 && x < tex_w then
                        let o = y * tex_w + x
                        pixels[o] = 0xff000000u32 | ((pixels[o] >> 2) & 0x3f3f3fu32)

    let dbg_draw = () ->
        let s = let t = (v.hires * present + 1) / 2 in if t < 1 then 1 else t
        let fps = if dbg_ms > 0.0 then (i32) (1000.0 / dbg_ms + 0.5) else 0
        let work = (i32) (dbg_work_ms + 0.5)
        let budget = (i32) (frame_ms() + 0.5)
        let mode = if effective_pref() == 0 then "auto" else "fixed"
        let aspect = if v.native then " 4:3" else ""
        let hz = if refresh_hz > 0 then (const str) alloca(" %d{refresh_hz}hz") else ""
        let lines = str[] { len = 4,
            alloca("fps %d{fps}  %d{work}/%d{budget} ms"),
            alloca("drops %d{dbg_drops}  jit %3.1f{dbg_jitter_ms} ms"),
            alloca("%d{v.sw}x%d{v.sh} %d{v.hires}x%s{aspect} %s{mode}"),
            alloca("out %d{drawable_w}x%d{drawable_h}%s{hz}")
        }
        let line_h = 9 * s
        let margin = 3 * s
        let mut maxw = 0
        for ln in lines do
            let lw = dbg_text_width(ln, s)
            if lw > maxw then maxw = lw
        let right = tex_w - margin
        dbg_dim(right - maxw - 2 * s, 0, tex_w, margin + line_h * 4 + s)
        let over = dbg_work_ms > frame_ms()
        for k in 0..4 do
            let red = k == 0 && (dbg_hitch > 0 || over)
            let mut x = right - dbg_text_width(lines[k], s)
            for ch in lines[k] do x = x + dbg_char(x, margin + k * line_h, (i32) ch, red, s)

    // xlatekey: SDL keysym -> Doom key code
    let xlatekey = (k: i32) ->
        if k == sdl2.key_left then dd.key_leftarrow
        else if k == sdl2.key_right then dd.key_rightarrow
        else if k == sdl2.key_down then dd.key_downarrow
        else if k == sdl2.key_up then dd.key_uparrow
        else if k == sdl2.key_escape then dd.key_escape
        else if k == sdl2.key_return || k == sdl2.key_kp_enter then dd.key_enter
        else if k == sdl2.key_tab then dd.key_tab
        else if k == sdl2.key_f1 then dd.key_f1
        else if k == sdl2.key_f2 then dd.key_f2
        else if k == sdl2.key_f3 then dd.key_f3
        else if k == sdl2.key_f4 then dd.key_f4
        else if k == sdl2.key_f5 then dd.key_f5
        else if k == sdl2.key_f6 then dd.key_f6
        else if k == sdl2.key_f7 then dd.key_f7
        else if k == sdl2.key_f8 then dd.key_f8
        else if k == sdl2.key_f9 then dd.key_f9
        else if k == sdl2.key_f10 then dd.key_f10
        else if k == sdl2.key_f11 then dd.key_f11
        else if k == sdl2.key_f12 then dd.key_f12
        else if k == sdl2.key_backspace || k == sdl2.key_delete then dd.key_backspace
        else if k == sdl2.key_pause then dd.key_pause
        else if k == sdl2.key_equals || k == sdl2.key_kp_plus then dd.key_equals
        else if k == sdl2.key_minus || k == sdl2.key_kp_minus then dd.key_minus
        else if k == sdl2.key_lshift || k == sdl2.key_rshift then dd.key_rshift
        else if k == sdl2.key_lctrl || k == sdl2.key_rctrl then dd.key_rctrl
        else if k == sdl2.key_lalt || k == sdl2.key_ralt then dd.key_ralt
        else if k > 0 && k < 128 then
            if k >= 'A' && k <= 'Z' then k - 'A' + 'a' else k
        else 0

    let toggle_fullscreen = () ->
        fullscreen = !fullscreen
        ignore sdl2.set_fullscreen(window, if fullscreen then sdl2.window_fullscreen_desktop else 0u32)

    let mut mouse_buttons = 0

    // ------------------------------------------------------------------
    // Headless scripted input (-script "w35 pesc w5 denter w1 uenter ...").
    // Tokens run at tic boundaries: wN waits N tics, dKEY / uKEY post a
    // key down / up, pKEY posts both, s:NAME saves shotdir/NAME.png, x
    // exits the level (to reach intermissions and finales in tests).
    // KEY is a single character or esc enter tab space up down left
    // right ctrl shift alt minus equals f1..f12.
    // ------------------------------------------------------------------

    let mut script = default(str)
    let mut script_pos = 0i64
    let mut script_wait = 0
    let mut pending_shot = default(str)

    let key_named = (name: const str) ->
        if name.len == 1 then (i32) name[0]
        else if name == "esc" then dd.key_escape
        else if name == "enter" then dd.key_enter
        else if name == "tab" then dd.key_tab
        else if name == "space" then (i32) ' '
        else if name == "up" then dd.key_uparrow
        else if name == "down" then dd.key_downarrow
        else if name == "left" then dd.key_leftarrow
        else if name == "right" then dd.key_rightarrow
        else if name == "ctrl" then dd.key_rctrl
        else if name == "shift" then dd.key_rshift
        else if name == "alt" then dd.key_ralt
        else if name == "minus" then dd.key_minus
        else if name == "equals" then dd.key_equals
        else if name == "pause" then dd.key_pause
        else if name.len >= 2 && name[0] == 'f' then
            let n = (i32) name[1] - '0'
            let n2 = if name.len == 3 then n * 10 + (i32) name[2] - '0' else n
            if n2 == 11 then dd.key_f11 else if n2 == 12 then dd.key_f12 else dd.key_f1 + n2 - 1
        else 0

    let run_script = () ->
        if script_wait > 0 then
            script_wait = script_wait - 1
            return
        loop
            if script_pos >= script.len || script_wait > 0 then break
            // next token
            let mut e = script_pos
            loop
                if e >= script.len || script[e] == ' ' then break
                e = e + 1
            let tok = script[script_pos..e]
            script_pos = e + 1
            if tok.len == 0 then continue
            let op = tok[0]
            let arg = tok[1..]
            if op == 'w' then
                let mut n = 0
                for ch in arg do n = n * 10 + (i32) ch - '0'
                script_wait = n - 1
            else if op == 'd' then post_key(evt.keydown, key_named(arg))
            else if op == 'u' then post_key(evt.keyup, key_named(arg))
            else if op == 'p' then
                post_key(evt.keydown, key_named(arg))
                post_key(evt.keyup, key_named(arg))
            else if op == 't' then
                // test hook: face DEG degrees (0 = east, 90 = north)
                let mut n = 0
                for ch in arg do n = n * 10 + (i32) ch - '0'
                match ds.players[ds.consoleplayer].mo with
                | some(mo) -> mo.angle = (u32) (((i64) n << 32) / 360)
                | none -> void()
            else if op == 'x' then
                // test hook: exit the level (G_ExitLevel)
                ds.g_exit_level()
            else if op == 's' && arg.len > 1 then
                if pending_shot.len > 0 then free(pending_shot)
                pending_shot = alloc("%s{arg[1..]}")!
                // the shot shows this tic; later tokens run next tic
                break

    let post_key = (type: i32, k: i32) ->
        if k != 0 then ds.post_event(event { type = type, data1 = k })

    // I_StartTic: drain SDL events into Doom's event queue.
    let start_tic = () ->
        if headless then run_script()
        else
            let mut e = default(sdl2.sdl_event)
            let mut mdx = 0
            let mut mdy = 0
            let mut moved = false
            loop
                if sdl2.poll_event(&e) == 0 then break
                let t = (i32) e.type
                if t == sdl2.quit_event then
                    quit_requested = true
                else if t == sdl2.windowevent then
                    // a resize, fullscreen toggle or DPI change: re-pick
                    // the render scale for the new drawable
                    if e.window.event == sdl2.windowevent_size_changed then
                        query_display()
                        repick()
                else if t == sdl2.keydown_event || t == sdl2.keyup_event then
                    let k = e.key.keysym.sym
                    if t == sdl2.keydown_event && k == sdl2.key_return
                        && (e.key.keysym.mod & sdl2.kmod_alt) != 0u16 then
                        if e.key.repeat == 0u8 then toggle_fullscreen()
                    else if k == sdl2.key_backquote then
                        if t == sdl2.keydown_event && e.key.repeat == 0u8 then toggle_debug()
                    else
                        let dk = xlatekey(k)
                        if dk != 0 then
                            ds.post_event(event {
                                type = if t == sdl2.keydown_event then evt.keydown else evt.keyup,
                                data1 = dk })
                else if t == sdl2.mousemotion_event then
                    if mouse_grabbed then
                        mdx = mdx + e.motion.xrel
                        mdy = mdy + e.motion.yrel
                        moved = true
                else if t == sdl2.mousebuttondown_event || t == sdl2.mousebuttonup_event then
                    if mouse_grabbed then
                        let bit = match (i32) e.button.button with
                                  | 1 -> 1
                                  | 3 -> 2
                                  | 2 -> 4
                                  | _ -> 0
                        if t == sdl2.mousebuttondown_event then mouse_buttons = mouse_buttons | bit
                        else mouse_buttons = mouse_buttons & ~bit
                        ds.post_event(event { type = evt.mouse, data1 = mouse_buttons })
            if moved then
                ds.post_event(event { type = evt.mouse, data1 = mouse_buttons,
                                      data2 = mdx << 2, data3 = if novert then 0 else (0 - mdy) << 2 })
            // grab the mouse only while actually playing
            set_grab(grabmouse && ds.gamestate == gs.level && !ds.menuactive && !ds.paused
                     && !ds.demoplayback)

    let mut quit_requested = false

    let start_frame = () -> void()
    let update_no_blit = () -> void()
