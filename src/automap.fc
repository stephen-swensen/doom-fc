// The automap (am_map.c), ported from linuxdoom-1.10 (GPLv2).

struct mline =
    ax: i32
    ay: i32
    bx: i32
    by: i32

struct fline =
    ax: i32
    ay: i32
    bx: i32
    by: i32

module amap =
    let reds = 256 - 5 * 16
    let redrange = 16
    let blues = 256 - 4 * 16 + 8
    let greens = 7 * 16
    let greenrange = 16
    let grays = 6 * 16
    let graysrange = 16
    let browns = 4 * 16
    let yellows = 256 - 32 + 7
    let black = 0
    let white = 256 - 47
    let background = 0
    let wallcolors = 256 - 5 * 16
    let wallrange = 16
    let tswallcolors = 6 * 16
    let fdwallcolors = 4 * 16
    let cdwallcolors = 256 - 32 + 7
    let thingcolors = 7 * 16
    let secretwallcolors = 256 - 5 * 16
    let gridcolors = 6 * 16 + 16 / 2
    let xhaircolors = 6 * 16
    let numthingrange = 16

    let panleftkey = dd.key_leftarrow
    let panrightkey = dd.key_rightarrow
    let panupkey = dd.key_uparrow
    let pandownkey = dd.key_downarrow
    let zoominkey = '='
    let zoomoutkey = '-'
    let startkey = dd.key_tab
    let endkey = dd.key_tab
    let gobigkey = '0'
    let followkey = 'f'
    let gridkey = 'g'
    let markkey = 'm'
    let clearmarkkey = 'c'
    let nummarkpoints = 10
    let f_paninc = 4
    // scale on entry
    let initscalemtof = 13107          // (int)(.2*FRACUNIT)
    // how much zoom-in per tic: goes to 2x in 1 second
    let m_zoomin = 66846                // (int)(1.02*FRACUNIT)
    // how much zoom-out per tic: pulls out to 0.5x in 1 second
    let m_zoomout = 64251               // (int)(FRACUNIT/1.02)

    let player_arrow = mline[] {
        mline { ax = -1048576, ay = 0, bx = 1198372, by = 0 },
        mline { ax = 1198372, ay = 0, bx = 599186, by = 299593 },
        mline { ax = 1198372, ay = 0, bx = 599186, by = -299593 },
        mline { ax = -1048576, ay = 0, bx = -1348168, by = 299593 },
        mline { ax = -1048576, ay = 0, bx = -1348168, by = -299593 },
        mline { ax = -748983, ay = 0, bx = -1048576, by = 299593 },
        mline { ax = -748983, ay = 0, bx = -1048576, by = -299593 }
    }
    let cheat_player_arrow = mline[] {
        mline { ax = -1048576, ay = 0, bx = 1198372, by = 0 },
        mline { ax = 1198372, ay = 0, bx = 599186, by = 199728 },
        mline { ax = 1198372, ay = 0, bx = 599186, by = -199728 },
        mline { ax = -1048576, ay = 0, bx = -1348168, by = 199728 },
        mline { ax = -1048576, ay = 0, bx = -1348168, by = -199728 },
        mline { ax = -748983, ay = 0, bx = -1048576, by = 199728 },
        mline { ax = -748983, ay = 0, bx = -1048576, by = -199728 },
        mline { ax = -599186, ay = 0, bx = -599186, by = -199728 },
        mline { ax = -599186, ay = -199728, bx = -399458, by = -199728 },
        mline { ax = -399458, ay = -199728, bx = -399458, by = 299593 },
        mline { ax = -199728, ay = 0, bx = -199728, by = -199728 },
        mline { ax = -199728, ay = -199728, bx = 0, by = -199728 },
        mline { ax = 0, ay = -199728, bx = 0, by = 299593 },
        mline { ax = 199728, ay = 299593, bx = 199728, by = -171196 },
        mline { ax = 199728, ay = -171196, bx = 237177, by = -208645 },
        mline { ax = 237177, ay = -208645, bx = 319565, by = -171196 }
    }
    let triangle_guy = mline[] {
        mline { ax = -56819, ay = -32768, bx = 56819, by = -32768 },
        mline { ax = 56819, ay = -32768, bx = 0, by = 65536 },
        mline { ax = 0, ay = 65536, bx = -56819, by = -32768 }
    }
    let thintriangle_guy = mline[] {
        mline { ax = -32768, ay = -45875, bx = 65536, by = 0 },
        mline { ax = 65536, ay = 0, bx = -32768, by = 45875 },
        mline { ax = -32768, ay = 45875, bx = -32768, by = -45875 }
    }

    let mut cheating = 0
    let mut grid = false
    let mut leveljuststarted = 1
    // The map window is the screen above the status bar, in screen pixels.
    let finit_width = () -> v.sw
    let finit_height = () -> v.sh - 32 * v.hy
    // Line width in pixels, so the map reads the same at a higher scale.
    let mut thick = 1
    // location of window on screen
    let mut f_x = 0
    let mut f_y = 0
    // size of window on screen
    let mut f_w = 0
    let mut f_h = 0
    let mut lightlev = 0    // used for funky strobing effect
    let mut fb = default(u8*)    // pseudo-frame buffer
    let mut amclock = 0
    let mut m_paninc_x = 0    // how far the window pans each tic (map coords)
    let mut m_paninc_y = 0
    let mut mtof_zoommul = 0    // how far the window zooms in each tic (map coords)
    let mut ftom_zoommul = 0    // how far the window zooms in each tic (fb coords)
    let mut m_x = 0    // LL x,y where the window is on the map (map coords)
    let mut m_y = 0
    let mut m_x2 = 0    // UR x,y where the window is on the map (map coords)
    let mut m_y2 = 0
    // width/height of window on map (map coords)
    let mut m_w = 0
    let mut m_h = 0
    // based on level size
    let mut min_x = 0
    let mut min_y = 0
    let mut max_x = 0
    let mut max_y = 0
    let mut max_w = 0    // max_x-min_x,
    let mut max_h = 0    // max_y-min_y
    // based on player size
    let mut min_w = 0
    let mut min_h = 0
    let mut min_scale_mtof = 0    // used to tell when to stop zooming out
    let mut max_scale_mtof = 0    // used to tell when to stop zooming in
    // old stuff for recovery later
    let mut old_m_w = 0
    let mut old_m_h = 0
    let mut old_m_x = 0
    let mut old_m_y = 0
    // old location used by the Follower routine
    let mut f_oldloc_x = 0
    let mut f_oldloc_y = 0
    // used by MTOF to scale from map-to-frame-buffer coords
    let mut scale_mtof = 13107
    // used by FTOM to scale from frame-buffer-to-map coords (=1/scale_mtof)
    let mut scale_ftom = 0
    let mut plr = default(player*)    // the player represented by an arrow
    let mut marknums = patch*[] { len = 10 }    // numbers used for marking by the automap
    let mut markpoints_x = i32[] { len = 10 }    // where the points are
    let mut markpoints_y = i32[] { len = 10 }
    let mut markpointnum = 0    // next point to be assigned
    let mut followplayer = true    // specifies whether to follow the player around
    let mut cheat_amap = default(cheatseq)
    let mut stopped = true
    let mut lastlevel = -1
    let mut lastepisode = -1
    let mut bigstate = false
    let mut markbuf = default(str)
    let mut nexttic = 0
    let litelevels = i32[] { 0, 4, 7, 10, 12, 14, 15, 15 }
    let mut litelevelscnt = 0

    let ftom = (x: i32) -> fx.mul(x << 16, scale_ftom)
    let mtof = (x: i32) -> fx.mul(x, scale_mtof) >> 16
    // translates between frame-buffer and map coordinates
    let cxmtof = (x: i32) -> f_x + mtof(x - m_x)
    let cymtof = (y: i32) -> f_y + (f_h - mtof(y - m_y))

    let activate_new_scale = () ->
        m_x = m_x + m_w / 2
        m_y = m_y + m_h / 2
        m_w = ftom(f_w)
        m_h = ftom(f_h)
        m_x = m_x - m_w / 2
        m_y = m_y - m_h / 2
        m_x2 = m_x + m_w
        m_y2 = m_y + m_h

    let save_scale_and_loc = () ->
        old_m_x = m_x
        old_m_y = m_y
        old_m_w = m_w
        old_m_h = m_h

    let restore_scale_and_loc = () ->
        m_w = old_m_w
        m_h = old_m_h
        if !followplayer then
            m_x = old_m_x
            m_y = old_m_y
        else
            let mo = plr.mo!
            m_x = mo.x - m_w / 2
            m_y = mo.y - m_h / 2
        m_x2 = m_x + m_w
        m_y2 = m_y + m_h
        // Change the scaling multipliers
        scale_mtof = fx.div(f_w << 16, m_w)
        scale_ftom = fx.div(fx.fracunit, scale_mtof)

    // adds a marker at the current location
    let add_mark = () ->
        markpoints_x[markpointnum] = m_x + m_w / 2
        markpoints_y[markpointnum] = m_y + m_h / 2
        markpointnum = (markpointnum + 1) % nummarkpoints

    // Determines bounding box of all vertices, sets global variables
    // controlling zoom range.
    let find_min_max_boundaries = () ->
        min_x = i32.max
        min_y = i32.max
        max_x = 0 - i32.max
        max_y = 0 - i32.max
        for k in 0..r.numvertexes do
            let vx = r.vertexes[k].x
            let vy = r.vertexes[k].y
            if vx < min_x then min_x = vx
            else if vx > max_x then max_x = vx
            if vy < min_y then min_y = vy
            else if vy > max_y then max_y = vy
        max_w = max_x - min_x
        max_h = max_y - min_y
        min_w = 2 * p.playerradius    // const? never changed?
        min_h = 2 * p.playerradius
        let a = fx.div(f_w << 16, max_w)
        let b = fx.div(f_h << 16, max_h)
        min_scale_mtof = if a < b then a else b
        max_scale_mtof = fx.div(f_h << 16, 2 * p.playerradius)

    let change_window_loc = () ->
        if m_paninc_x != 0 || m_paninc_y != 0 then
            followplayer = false
            f_oldloc_x = i32.max
        m_x = m_x + m_paninc_x
        m_y = m_y + m_paninc_y
        if m_x + m_w / 2 > max_x then m_x = max_x - m_w / 2
        else if m_x + m_w / 2 < min_x then m_x = min_x - m_w / 2
        if m_y + m_h / 2 > max_y then m_y = max_y - m_h / 2
        else if m_y + m_h / 2 < min_y then m_y = min_y - m_h / 2
        m_x2 = m_x + m_w
        m_y2 = m_y + m_h

    let init_variables = () ->
        ds.automapactive = true
        fb = v.screens[0]
        f_oldloc_x = i32.max
        amclock = 0
        lightlev = 0
        m_paninc_x = 0
        m_paninc_y = 0
        ftom_zoommul = fx.fracunit
        mtof_zoommul = fx.fracunit
        m_w = ftom(f_w)
        m_h = ftom(f_h)
        // find player to center on initially
        let mut pnum = ds.consoleplayer
        if !ds.playeringame[pnum] then
            pnum = 0
            loop
                if pnum >= dd.maxplayers || ds.playeringame[pnum] then break
                pnum = pnum + 1
        plr = &ds.players[pnum]
        let mo = plr.mo!
        m_x = mo.x - m_w / 2
        m_y = mo.y - m_h / 2
        change_window_loc()
        // for saving & restoring
        old_m_x = m_x
        old_m_y = m_y
        old_m_w = m_w
        old_m_h = m_h
        // inform the status bar of the change
        st.automap_changed(true)

    let load_pics = () ->
        for k in 0..10 do marknums[k] = v.patch_named_mut("AMMNUM%d{k}")

    let clear_marks = () ->
        for k in 0..nummarkpoints do markpoints_x[k] = -1    // means empty
        markpointnum = 0

    // should be called at the start of every level
    // right now, i figure it out myself
    let level_init = () ->
        leveljuststarted = 0
        f_x = 0
        f_y = 0
        f_w = finit_width()
        f_h = finit_height()
        thick = (v.hires + 1) / 2
        clear_marks()
        find_min_max_boundaries()
        scale_mtof = fx.div(min_scale_mtof, 45875)    // (int)(0.7*FRACUNIT)
        if scale_mtof > max_scale_mtof then scale_mtof = min_scale_mtof
        scale_ftom = fx.div(fx.fracunit, scale_mtof)

    let stop = () ->
        ds.automapactive = false
        st.automap_changed(false)
        stopped = true

    let start = () ->
        if !stopped then stop()
        stopped = false
        if lastlevel != ds.gamemap || lastepisode != ds.gameepisode then
            level_init()
            lastlevel = ds.gamemap
            lastepisode = ds.gameepisode
        init_variables()
        load_pics()

    // set the window scale to the maximum size
    let min_out_window_scale = () ->
        scale_mtof = min_scale_mtof
        scale_ftom = fx.div(fx.fracunit, scale_mtof)
        activate_new_scale()

    // set the window scale to the minimum size
    let max_out_window_scale = () ->
        scale_mtof = max_scale_mtof
        scale_ftom = fx.div(fx.fracunit, scale_mtof)
        activate_new_scale()

    // Handle events (user inputs) in automap mode
    let responder = (ev: event) ->
        let mut rc = false
        if !ds.automapactive then
            if ev == event.keydown(startkey) then
                start()
                ds.viewactive = false
                rc = true
        else
            match ev with
            | keydown(k) ->
                rc = true
                if k == panrightkey then
                    // pan right
                    if !followplayer then m_paninc_x = ftom(f_paninc * v.hires) else rc = false
                else if k == panleftkey then
                    // pan left
                    if !followplayer then m_paninc_x = 0 - ftom(f_paninc * v.hires) else rc = false
                else if k == panupkey then
                    // pan up
                    if !followplayer then m_paninc_y = ftom(f_paninc * v.hires) else rc = false
                else if k == pandownkey then
                    // pan down
                    if !followplayer then m_paninc_y = 0 - ftom(f_paninc * v.hires) else rc = false
                else if k == zoomoutkey then
                    // zoom out
                    mtof_zoommul = m_zoomout
                    ftom_zoommul = m_zoomin
                else if k == zoominkey then
                    // zoom in
                    mtof_zoommul = m_zoomin
                    ftom_zoommul = m_zoomout
                else if k == endkey then
                    bigstate = false
                    ds.viewactive = true
                    stop()
                else if k == gobigkey then
                    bigstate = !bigstate
                    if bigstate then
                        save_scale_and_loc()
                        min_out_window_scale()
                    else restore_scale_and_loc()
                else if k == followkey then
                    followplayer = !followplayer
                    f_oldloc_x = i32.max
                    plr.message = if followplayer then dstr.amstr_followon else dstr.amstr_followoff
                else if k == gridkey then
                    grid = !grid
                    plr.message = if grid then dstr.amstr_gridon else dstr.amstr_gridoff
                else if k == markkey then
                    if markbuf.len > 0 then free(markbuf)
                    markbuf = alloc("%s{dstr.amstr_markedspot} %d{markpointnum}")!
                    plr.message = markbuf
                    add_mark()
                else if k == clearmarkkey then
                    clear_marks()
                    plr.message = dstr.amstr_markscleared
                else
                    rc = false
                if ds.deathmatch == 0 && cheat.check(&cheat_amap, k) then
                    rc = false
                    cheating = (cheating + 1) % 3
            | keyup(k) ->
                rc = false
                if k == panrightkey || k == panleftkey then
                    if !followplayer then m_paninc_x = 0
                else if k == panupkey || k == pandownkey then
                    if !followplayer then m_paninc_y = 0
                else if k == zoomoutkey || k == zoominkey then
                    mtof_zoommul = fx.fracunit
                    ftom_zoommul = fx.fracunit
            | mouse(_) -> void()
        rc

    // Zooming
    let change_window_scale = () ->
        // Change the scaling multipliers
        scale_mtof = fx.mul(scale_mtof, mtof_zoommul)
        scale_ftom = fx.div(fx.fracunit, scale_mtof)
        if scale_mtof < min_scale_mtof then min_out_window_scale()
        else if scale_mtof > max_scale_mtof then max_out_window_scale()
        else activate_new_scale()

    let do_follow_player = () ->
        let mo = plr.mo!
        if f_oldloc_x != mo.x || f_oldloc_y != mo.y then
            m_x = ftom(mtof(mo.x)) - m_w / 2
            m_y = ftom(mtof(mo.y)) - m_h / 2
            m_x2 = m_x + m_w
            m_y2 = m_y + m_h
            f_oldloc_x = mo.x
            f_oldloc_y = mo.y

    let update_light_lev = () ->
        // Change light level
        if amclock > nexttic then
            lightlev = litelevels[litelevelscnt]
            litelevelscnt = litelevelscnt + 1
            if litelevelscnt == 8 then litelevelscnt = 0
            nexttic = amclock + 6 - (amclock % 6)

    // Updates on Game Tick
    let ticker = () ->
        if !ds.automapactive then return
        amclock = amclock + 1
        if followplayer then do_follow_player()
        // Change the zoom if necessary
        if ftom_zoommul != fx.fracunit then change_window_scale()
        // Change x,y location
        if m_paninc_x != 0 || m_paninc_y != 0 then change_window_loc()
        // Update light level
        // AM_updateLightLev();

    // Clear automap frame buffer.
    let clear_fb = (color: i32) -> mem.memset((any*) fb, color, (i64) f_w * f_h)

    let c_left = 1
    let c_right = 2
    let c_bottom = 4
    let c_top = 8

    let outcode = (mx: i32, my: i32) ->
        let mut oc = 0
        if my < 0 then oc = oc | c_top
        else if my >= f_h then oc = oc | c_bottom
        if mx < 0 then oc = oc | c_left
        else if mx >= f_w then oc = oc | c_right
        oc

    // The screens were reallocated at a new render scale: keep the same
    // part of the map in view.
    let resize = () ->
        let old_w = f_w
        f_w = finit_width()
        f_h = finit_height()
        thick = (v.hires + 1) / 2
        fb = v.screens[0]
        if old_w > 0 && r.numvertexes > 0 then
            find_min_max_boundaries()
            scale_mtof = (i32) ((i64) scale_mtof * f_w / old_w)
            scale_ftom = fx.div(fx.fracunit, scale_mtof)
            activate_new_scale()

    // One line point, thick x thick pixels.
    let put = (x: i32, y: i32, color: i32) ->
        if thick == 1 then *(fb + (y * f_w + x)) = (u8) color
        else
            let x0 = x - thick / 2
            let y0 = y - thick / 2
            for yy in y0..y0 + thick do
                if yy >= 0 && yy < f_h then
                    for xx in x0..x0 + thick do
                        if xx >= 0 && xx < f_w then *(fb + (yy * f_w + xx)) = (u8) color

    // Automap clipping of lines. Based on Cohen-Sutherland clipping
    // algorithm but with a slightly faster reject and precalculated slopes.
    // If the speed is needed, use a hash algorithm to handle the common
    // cases.
    let clip_mline = (ml: const mline*, fl: fline*) ->
        let mut outcode1 = 0
        let mut outcode2 = 0
        // do trivial rejects and outcodes
        if ml.ay > m_y2 then outcode1 = c_top
        else if ml.ay < m_y then outcode1 = c_bottom
        if ml.by > m_y2 then outcode2 = c_top
        else if ml.by < m_y then outcode2 = c_bottom
        if (outcode1 & outcode2) != 0 then return false    // trivially outside
        if ml.ax < m_x then outcode1 = outcode1 | c_left
        else if ml.ax > m_x2 then outcode1 = outcode1 | c_right
        if ml.bx < m_x then outcode2 = outcode2 | c_left
        else if ml.bx > m_x2 then outcode2 = outcode2 | c_right
        if (outcode1 & outcode2) != 0 then return false    // trivially outside
        // transform to frame-buffer coordinates.
        fl.ax = cxmtof(ml.ax)
        fl.ay = cymtof(ml.ay)
        fl.bx = cxmtof(ml.bx)
        fl.by = cymtof(ml.by)
        outcode1 = outcode(fl.ax, fl.ay)
        outcode2 = outcode(fl.bx, fl.by)
        if (outcode1 & outcode2) != 0 then return false
        loop
            if (outcode1 | outcode2) == 0 then break
            // may be partially inside box
            // find an outside point
            let outside = if outcode1 != 0 then outcode1 else outcode2
            let mut tx = 0
            let mut ty = 0
            // clip to each side
            if (outside & c_top) != 0 then
                let dy = fl.ay - fl.by
                let dx = fl.bx - fl.ax
                tx = fl.ax + (i32) ((i64) dx * fl.ay / dy)
                ty = 0
            else if (outside & c_bottom) != 0 then
                let dy = fl.ay - fl.by
                let dx = fl.bx - fl.ax
                tx = fl.ax + (i32) ((i64) dx * (fl.ay - f_h) / dy)
                ty = f_h - 1
            else if (outside & c_right) != 0 then
                let dy = fl.by - fl.ay
                let dx = fl.bx - fl.ax
                ty = fl.ay + (i32) ((i64) dy * (f_w - 1 - fl.ax) / dx)
                tx = f_w - 1
            else if (outside & c_left) != 0 then
                let dy = fl.by - fl.ay
                let dx = fl.bx - fl.ax
                ty = fl.ay + (i32) ((i64) dy * (0 - fl.ax) / dx)
                tx = 0
            if outside == outcode1 then
                fl.ax = tx
                fl.ay = ty
                outcode1 = outcode(fl.ax, fl.ay)
            else
                fl.bx = tx
                fl.by = ty
                outcode2 = outcode(fl.bx, fl.by)
            if (outcode1 & outcode2) != 0 then return false    // trivially outside
        true

    // Classic Bresenham w/ whatever optimizations needed for speed
    let draw_fline = (fl: const fline*, color: i32) ->
        if fl.ax < 0 || fl.ax >= f_w || fl.ay < 0 || fl.ay >= f_h
            || fl.bx < 0 || fl.bx >= f_w || fl.by < 0 || fl.by >= f_h then
            return
        let dx = fl.bx - fl.ax
        let ax = 2 * (if dx < 0 then 0 - dx else dx)
        let sx = if dx < 0 then -1 else 1
        let dy = fl.by - fl.ay
        let ay = 2 * (if dy < 0 then 0 - dy else dy)
        let sy = if dy < 0 then -1 else 1
        let mut x = fl.ax
        let mut y = fl.ay
        if ax > ay then
            let mut d = ay - ax / 2
            loop
                put(x, y, color)
                if x == fl.bx then break
                if d >= 0 then
                    y = y + sy
                    d = d - ax
                x = x + sx
                d = d + ay
        else
            let mut d = ax - ay / 2
            loop
                put(x, y, color)
                if y == fl.by then break
                if d >= 0 then
                    x = x + sx
                    d = d - ay
                y = y + sy
                d = d + ax

    let mut fl_tmp = default(fline)

    // Clip lines, draw visible part sof lines.
    let draw_mline = (ml: const mline*, color: i32) ->
        if clip_mline(ml, &fl_tmp) then draw_fline(&fl_tmp, color)    // draws it on frame buffer using fb coords

    // Draws flat (floor/ceiling tile) aligned grid lines.
    let draw_grid = (color: i32) ->
        let unit = p.mapblockunits << 16
        // Figure out start of vertical gridlines
        let mut start = m_x
        if (start - p.bmaporgx) % unit != 0 then start = start + unit - ((start - p.bmaporgx) % unit)
        let mut end = m_x + m_w
        // draw vertical gridlines
        let mut ml = mline { ay = m_y, by = m_y + m_h }
        let mut x = start
        loop
            if x >= end then break
            ml.ax = x
            ml.bx = x
            draw_mline(&ml, color)
            x = x + unit
        // Figure out start of horizontal gridlines
        start = m_y
        if (start - p.bmaporgy) % unit != 0 then start = start + unit - ((start - p.bmaporgy) % unit)
        end = m_y + m_h
        // draw horizontal gridlines
        ml.ax = m_x
        ml.bx = m_x + m_w
        let mut y = start
        loop
            if y >= end then break
            ml.ay = y
            ml.by = y
            draw_mline(&ml, color)
            y = y + unit

    // Determines visible lines, draws them. This is LineDef based, not
    // LineSeg based.
    let draw_walls = () ->
        for k in 0..r.numlines do
            let ln = &r.lines[k]
            let l = mline { ax = ln.v1.x, ay = ln.v1.y, bx = ln.v2.x, by = ln.v2.y }
            if cheating != 0 || (ln.flags & ml.mapped) != 0 then
                if (ln.flags & ml.dontdraw) != 0 && cheating == 0 then continue
                match ln.backsector with
                | none -> draw_mline(&l, wallcolors + lightlev)
                | some(back) ->
                    if ln.special == 39 then
                        // teleporters
                        draw_mline(&l, wallcolors + wallrange / 2)
                    else if (ln.flags & ml.secret) != 0 then
                        // secret door
                        if cheating != 0 then draw_mline(&l, secretwallcolors + lightlev)
                        else draw_mline(&l, wallcolors + lightlev)
                    else if back.floorheight != ln.frontsector.floorheight then
                        draw_mline(&l, fdwallcolors + lightlev)    // floor level change
                    else if back.ceilingheight != ln.frontsector.ceilingheight then
                        draw_mline(&l, cdwallcolors + lightlev)    // ceiling level change
                    else if cheating != 0 then
                        draw_mline(&l, tswallcolors + lightlev)
            else if plr.powers[pw.allmap] != 0 then
                if (ln.flags & ml.dontdraw) == 0 then draw_mline(&l, grays + 3)

    // Rotation in 2D. Used to rotate player arrow line character.
    let rotate = (x: i32*, y: i32*, a: u32) ->
        let fa = fx.fine(a)
        let tmpx = fx.mul(*x, tables.cos(fa)) - fx.mul(*y, tables.sin(fa))
        *y = fx.mul(*x, tables.sin(fa)) + fx.mul(*y, tables.cos(fa))
        *x = tmpx

    let draw_line_character = (lineguy: const mline[], scale: i32, angle: u32, color: i32, x: i32, y: i32) ->
        for k in 0..lineguy.len do
            let mut l = lineguy[k]
            let mut ax = l.ax
            let mut ay = l.ay
            if scale != 0 then
                ax = fx.mul(scale, ax)
                ay = fx.mul(scale, ay)
            if angle != 0u32 then rotate(&ax, &ay, angle)
            l.ax = ax + x
            l.ay = ay + y
            let mut bx = l.bx
            let mut by = l.by
            if scale != 0 then
                bx = fx.mul(scale, bx)
                by = fx.mul(scale, by)
            if angle != 0u32 then rotate(&bx, &by, angle)
            l.bx = bx + x
            l.by = by + y
            draw_mline(&l, color)

    let their_colors = i32[] { 7 * 16, 6 * 16, 4 * 16, 256 - 5 * 16 }

    let draw_players = () ->
        if !ds.netgame then
            let mo = plr.mo!
            let arrow = if cheating != 0 then cheat_player_arrow else player_arrow
            draw_line_character(arrow, 0, mo.angle, white, mo.x, mo.y)
            return
        let mut their_color = -1
        for k in 0..dd.maxplayers do
            their_color = their_color + 1
            let pl = &ds.players[k]
            if (ds.deathmatch != 0 && !ds.singledemo) && pl != plr then continue
            if !ds.playeringame[k] then continue
            let color = if pl.powers[pw.invisibility] != 0 then 246    // *close* to black
                        else their_colors[their_color]
            let mo = pl.mo!
            draw_line_character(player_arrow, 0, mo.angle, color, mo.x, mo.y)

    let draw_things = (colors: i32, colorrange: i32) ->
        for k in 0..r.numsectors do
            let mut cur = r.sectors[k].thinglist
            loop
                match cur with
                | none -> break
                | some(t) ->
                    draw_line_character(thintriangle_guy, 16 << 16, t.angle, colors + lightlev, t.x, t.y)
                    cur = t.snext

    let draw_marks = () ->
        for k in 0..nummarkpoints do
            if markpoints_x[k] != -1 then
                let w = 5    // because something's wrong with the wad, i guess
                let h = 6    // because something's wrong with the wad, i guess
                let fx0 = cxmtof(markpoints_x[k])
                let fy0 = cymtof(markpoints_y[k])
                let n = v.hires
                let ny = v.hy
                if fx0 >= f_x && fx0 <= f_w - w * n && fy0 >= f_y && fy0 <= f_h - h * ny then
                    v.draw_patch(fx0 / n, fy0 / ny, 0, marknums[k])

    let draw_crosshair = (color: i32) ->
        put(f_w / 2, (f_h + 1) / 2, color)    // single point for now

    let drawer = () ->
        if !ds.automapactive then return
        // again here, for frame interpolation's in-between positions
        if followplayer then do_follow_player()
        clear_fb(background)
        if grid then draw_grid(gridcolors)
        draw_walls()
        draw_players()
        if cheating == 2 then draw_things(thingcolors, numthingrange)
        draw_crosshair(xhaircolors)
        draw_marks()
        v.mark_rect(f_x, f_y, f_w, f_h)

    let init = () ->
        cheat_amap = cheat.make(u8[] { 0xb2u8, 0x26u8, 0x26u8, 0x2eu8, 0xffu8 })
