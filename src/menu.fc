// m_misc (config file, file I/O, screenshots) and m_menu (the whole menu
// system), ported from linuxdoom-1.10 (GPLv2). Menu routines are function
// pointers in C; here a menu item names its routine with a small integer
// and m.call_routine dispatches.

module misc =
    import io from std::

    // controls (have defaults)
    let mut key_right = dd.key_rightarrow
    let mut key_left = dd.key_leftarrow
    let mut key_up = dd.key_uparrow
    let mut key_down = dd.key_downarrow
    let mut key_strafeleft = (i32) ','
    let mut key_straferight = (i32) '.'
    let mut key_fire = dd.key_rctrl
    let mut key_use = (i32) ' '
    let mut key_strafe = dd.key_ralt
    let mut key_speed = dd.key_rshift
    let mut mousebfire = 0
    let mut mousebstrafe = 1
    let mut mousebforward = 2
    let mut usemouse = 1
    let mut snd_channels = 8

    let mut home_dir = default(str)

    // ~/.doom-fc (created on demand), where config, saves and
    // screenshots live.
    let config_dir = () ->
        if home_dir.len == 0 then
            let over = cstdlib.getenv(c"DOOM_FC_HOME")
            if c.not_null(over) then
                home_dir = alloc("%s{(const str) over}")!
            else
                let h = cstdlib.getenv(c"HOME")
                let base = if c.is_null(h) then (const str) "." else (const str) h
                home_dir = alloc("%s{base}/.doom-fc")!
            ignore cdir.mkdir(alloca((cstr) home_dir), 0o755u32)
        (const str) home_dir

    let default_file = () -> alloc("%s{config_dir()}/default.cfg")!

    let save_name = (slot: i32) -> alloc("%s{config_dir()}/doomsav%d{slot}.dsg")!

    // M_WriteFile
    let write_file = (name: const str, source: const u8*, length: i64) ->
        let f = cstdio.fopen(alloca((cstr) name), c"wb")
        if c.is_null(f) then false
        else
            let count = cstdio.fwrite((const any*) source, 1usize, (usize) length, f)
            ignore cstdio.fclose(f)
            (i64) count == length

    // M_ReadFile: the whole file in a heap buffer, or none
    let read_file = (name: const str) ->
        let f = cstdio.fopen(alloca((cstr) name), c"rb")
        if c.is_null(f) then none(u8[])
        else
            ignore cstdio.fseek(f, 0i64, cstdio.seek_end)
            let len = cstdio.ftell(f)
            ignore cstdio.fseek(f, 0i64, cstdio.seek_set)
            let buf = alloc(u8[] { len = if len < 1 then 1i64 else len })!
            ignore cstdio.fread((any*) buf.ptr, 1usize, (usize) len, f)
            ignore cstdio.fclose(f)
            some(buf)

    let defaults_names = (const str)[] {
        "mouse_sensitivity", "sfx_volume", "music_volume", "show_messages",
        "key_right", "key_left", "key_up", "key_down", "key_strafeleft", "key_straferight",
        "key_fire", "key_use", "key_strafe", "key_speed",
        "use_mouse", "mouseb_fire", "mouseb_strafe", "mouseb_forward",
        "screenblocks", "detaillevel", "snd_channels", "usegamma",
        "scale_factor"
    }

    let default_ptr = (k: i32) ->
        match k with
        | 0 -> &ds.mouse_sensitivity
        | 1 -> &ds.snd_sfxvolume
        | 2 -> &ds.snd_musicvolume
        | 3 -> &ds.show_messages
        | 4 -> &key_right
        | 5 -> &key_left
        | 6 -> &key_up
        | 7 -> &key_down
        | 8 -> &key_strafeleft
        | 9 -> &key_straferight
        | 10 -> &key_fire
        | 11 -> &key_use
        | 12 -> &key_strafe
        | 13 -> &key_speed
        | 14 -> &usemouse
        | 15 -> &mousebfire
        | 16 -> &mousebstrafe
        | 17 -> &mousebforward
        | 18 -> &ds.screenblocks
        | 19 -> &ds.detail_level
        | 20 -> &snd_channels
        | 21 -> &ds.usegamma
        | _ -> &iv.scale_factor

    let default_values = i32[] {
        5, 8, 8, 1,
        dd.key_rightarrow, dd.key_leftarrow, dd.key_uparrow, dd.key_downarrow, ',', '.',
        dd.key_rctrl, ' ', dd.key_ralt, dd.key_rshift,
        1, 0, 1, 2,
        9, 0, 8, 0,
        0
    }

    let save_defaults = () ->
        let name = default_file()
        defer free(name)
        let f = cstdio.fopen(alloca((cstr) name), c"w")
        if c.is_null(f) then return
        for k in 0..defaults_names.len do
            let line = alloca("%s{defaults_names[k]}\t\t%d{*default_ptr((i32) k)}\n")
            ignore cstdio.fwrite((const any*) line.ptr, 1usize, (usize) line.len, f)
        ignore cstdio.fclose(f)

    private let parse_int = (s: const str) ->
        let mut k = 0
        let mut neg = false
        if s.len > 0 && s[0] == '-' then
            neg = true
            k = 1
        let mut v = 0
        if s.len > k + 1 && s[k] == '0' && (s[k + 1] == 'x' || s[k + 1] == 'X') then
            k = k + 2
            loop
                if k >= s.len then break
                let ch = s[k]
                let d = if ch >= '0' && ch <= '9' then (i32) ch - '0'
                        else if ch >= 'a' && ch <= 'f' then (i32) ch - 'a' + 10
                        else if ch >= 'A' && ch <= 'F' then (i32) ch - 'A' + 10
                        else -1
                if d < 0 then break
                v = v * 16 + d
                k = k + 1
        else
            loop
                if k >= s.len || s[k] < '0' || s[k] > '9' then break
                v = v * 10 + (i32) s[k] - '0'
                k = k + 1
        if neg then 0 - v else v

    let load_defaults = () ->
        // set everything to base values
        for k in 0..defaults_names.len do *default_ptr((i32) k) = default_values[k]
        // check for a custom default file
        let pk = argv.check_parm("-config")
        let name = if pk != 0 && pk < argv.count() - 1 then alloc("%s{argv.get(pk + 1)}")! else default_file()
        defer free(name)
        // read the file in, overriding any set defaults
        match read_file(name) with
        | none -> void()
        | some(buf) ->
            defer free(buf)
            let mut pos = 0i64
            loop
                if pos >= buf.len then break
                // one line
                let mut eol = pos
                loop
                    if eol >= buf.len || buf[eol] == '\n' then break
                    eol = eol + 1
                let line = buf[pos..eol]
                pos = eol + 1
                // name, whitespace, value
                let mut a = 0i64
                loop
                    if a >= line.len || line[a] == ' ' || line[a] == '\t' then break
                    a = a + 1
                let key = line[0..a]
                loop
                    if a >= line.len || (line[a] != ' ' && line[a] != '\t') then break
                    a = a + 1
                let value = line[a..]
                if value.len > 0 && value[0] != '"' then
                    for k in 0..defaults_names.len do
                        if key == defaults_names[k] then *default_ptr((i32) k) = parse_int(value)

    // M_ScreenShot: ~/.doom-fc/screenshots/doomNN.png
    let mut shot_slot = 0

    let screen_shot = () ->
        let dir = alloc("%s{config_dir()}/screenshots")!
        defer free(dir)
        ignore cdir.mkdir(alloca((cstr) dir), 0o755u32)
        let fb = alloc(u32[] { len = v.sw * v.sh })!
        defer free(fb)
        iv.frame_argb(fb)
        let mut done = false
        loop
            if done || shot_slot > 99 then break
            let name = alloc("%s{dir}/doom%02d{shot_slot}.png")!
            defer free(name)
            shot_slot = shot_slot + 1
            if !io.exists(name) then
                ignore png.write(name, fb, v.sw, v.sh, "")
                done = true
        ds.players[ds.consoleplayer].message = if done then (const str) "screen shot" else (const str) "M_ScreenShot: Couldn't create a PNG"

struct menuitem =
    // 0 = no cursor here, 1 = ok, 2 = arrows ok, -1 = empty line
    status: i32
    name: const str
    routine: i32
    alphakey: i32

struct menudef =
    numitems: i32
    prev: menudef*
    items: menuitem*
    routine: i32
    x: i32
    y: i32
    laston: i32

module m =
    let skullxoff = -32
    let lineheight = 16
    let savestringsize = 24

    // menu routines (the C function pointers)
    let r_none = 0
    let r_new_game = 1
    let r_options = 2
    let r_load_game = 3
    let r_save_game = 4
    let r_read_this = 5
    let r_quit_doom = 6
    let r_episode = 7
    let r_choose_skill = 8
    let r_end_game = 9
    let r_change_messages = 10
    let r_change_detail = 11
    let r_size_display = 12
    let r_change_sensitivity = 13
    let r_sound = 14
    let r_read_this2 = 15
    let r_finish_read_this = 16
    let r_sfx_vol = 17
    let r_music_vol = 18
    let r_load_select = 19
    let r_save_select = 20
    let r_change_scale = 21
    // drawers
    let d_main = 1
    let d_episode = 2
    let d_new_game = 3
    let d_options = 4
    let d_read_this1 = 5
    let d_read_this2 = 6
    let d_sound = 7
    let d_load = 8
    let d_save = 9
    // message responses
    let mr_none = 0
    let mr_quick_save = 1
    let mr_quick_load = 2
    let mr_verify_nightmare = 3
    let mr_end_game = 4
    let mr_quit = 5

    let mut screen_size = 0
    let mut quick_save_slot = -1
    let mut message_to_print = 0
    let mut message_string = ""
    let mut message_last_menu_active = false
    let mut message_needs_input = false
    let mut message_routine = 0
    let mut save_string_enter = false
    let mut save_slot = 0
    let mut save_char_index = 0
    let mut save_old_string = u8[] { len = 24 }
    let mut savegamestrings = u8[] { len = 240 }
    let mut item_on = 0
    let mut skull_anim_counter = 0
    let mut which_skull = 0
    let mut current_menu = default(menudef*)
    let mut epi = 0
    let mut tempstring = default(str)
    let mut endstring = default(str)

    let gammamsg = (const str)[] { dstr.gammalvl0, dstr.gammalvl1, dstr.gammalvl2, dstr.gammalvl3, dstr.gammalvl4 }
    let skull_name = (const str)[] { "M_SKULL1", "M_SKULL2" }
    let detail_names = (const str)[] { "M_GDHIGH", "M_GDLOW" }
    let msg_names = (const str)[] { "M_MSGOFF", "M_MSGON" }

    // The DOS v1.9 quit messages. (linuxdoom's endmsg[] lost two commas,
    // which runs M_QuitDOOM off the end of the table.)
    let endmsg1 = (const str)[] {
        "please don't leave, there's more\ndemons to toast!",
        "let's beat it -- this is turning\ninto a bloodbath!",
        "i wouldn't leave if i were you.\ndos is much worse.",
        "you're trying to say you like dos\nbetter than me, right?",
        "don't leave yet -- there's a\ndemon around that corner!",
        "ya know, next time you come in here\ni'm gonna toast ya.",
        "go ahead and leave. see if i care."
    }
    let endmsg2 = (const str)[] {
        "you want to quit?\nthen, thou hast lost an eighth!",
        "don't go now, there's a \ndimensional shambler waiting\nat the dos prompt!",
        "get outta here and go back\nto your boring programs.",
        "if i were your boss, i'd \n deathmatch ya in a minute!",
        "look, bud. you leave now\nand you forfeit your body count!",
        "just leave. when you come\nback, i'll be waiting with a bat.",
        "you're lucky i don't smack\nyou for thinking about leaving."
    }

    let quitsounds = i32[] { sfx.pldeth, sfx.dmpain, sfx.popain, sfx.slop, sfx.telept, sfx.posit1, sfx.posit3, sfx.sgtatk }
    let quitsounds2 = i32[] { sfx.vilact, sfx.getpow, sfx.boscub, sfx.slop, sfx.skeswg, sfx.kntdth, sfx.bspact, sfx.sgtatk }

    // the menus
    let mut main_menu = menuitem[] { len = 6 }
    let mut episode_menu = menuitem[] { len = 4 }
    let mut new_game_menu = menuitem[] { len = 5 }
    let mut options_menu = menuitem[] { len = 8 }
    let mut read_menu1 = menuitem[] { len = 1 }
    let mut read_menu2 = menuitem[] { len = 1 }
    let mut sound_menu = menuitem[] { len = 4 }
    let mut load_menu = menuitem[] { len = 6 }
    let mut save_menu = menuitem[] { len = 6 }

    let mut main_def = default(menudef)
    let mut epi_def = default(menudef)
    let mut new_def = default(menudef)
    let mut options_def = default(menudef)
    let mut read_def1 = default(menudef)
    let mut read_def2 = default(menudef)
    let mut sound_def = default(menudef)
    let mut load_def = default(menudef)
    let mut save_def = default(menudef)

    // main menu items
    let readthis = 4
    let quitdoom = 5
    // options items
    let endgame = 0
    let messages = 1
    let detail = 2
    let scrnsize = 3
    let mousesens = 5
    let soundvol = 7
    // sound items
    let sfx_vol = 0
    let music_vol = 2
    // skills
    let nightmare = 4

    let mi = (status: i32, name: const str, routine: i32, alphakey: i32) ->
        menuitem { status = status, name = name, routine = routine, alphakey = alphakey }

    let build_menus = () ->
        main_menu[0] = mi(1, "M_NGAME", r_new_game, 'n')
        main_menu[1] = mi(1, "M_OPTION", r_options, 'o')
        main_menu[2] = mi(1, "M_LOADG", r_load_game, 'l')
        main_menu[3] = mi(1, "M_SAVEG", r_save_game, 's')
        // Another hickup with Special edition.
        main_menu[4] = mi(1, "M_RDTHIS", r_read_this, 'r')
        main_menu[5] = mi(1, "M_QUITG", r_quit_doom, 'q')
        main_def = menudef { numitems = 6, items = main_menu.ptr, routine = d_main, x = 97, y = 64 }
        episode_menu[0] = mi(1, "M_EPI1", r_episode, 'k')
        episode_menu[1] = mi(1, "M_EPI2", r_episode, 't')
        episode_menu[2] = mi(1, "M_EPI3", r_episode, 'i')
        episode_menu[3] = mi(1, "M_EPI4", r_episode, 't')
        epi_def = menudef { numitems = 4, prev = &main_def, items = episode_menu.ptr, routine = d_episode, x = 48, y = 63 }
        new_game_menu[0] = mi(1, "M_JKILL", r_choose_skill, 'i')
        new_game_menu[1] = mi(1, "M_ROUGH", r_choose_skill, 'h')
        new_game_menu[2] = mi(1, "M_HURT", r_choose_skill, 'h')
        new_game_menu[3] = mi(1, "M_ULTRA", r_choose_skill, 'u')
        new_game_menu[4] = mi(1, "M_NMARE", r_choose_skill, 'n')
        new_def = menudef { numitems = 5, prev = &epi_def, items = new_game_menu.ptr, routine = d_new_game, x = 48, y = 63, laston = 2 }
        options_menu[0] = mi(1, "M_ENDGAM", r_end_game, 'e')
        options_menu[1] = mi(1, "M_MESSG", r_change_messages, 'm')
        // doom-fc: Graphic Detail sets the render scale (linuxdoom's
        // low-detail toggle here did nothing)
        options_menu[2] = mi(2, "M_DETAIL", r_change_scale, 'g')
        options_menu[3] = mi(2, "M_SCRNSZ", r_size_display, 's')
        options_menu[4] = mi(-1, "", r_none, 0)
        options_menu[5] = mi(2, "M_MSENS", r_change_sensitivity, 'm')
        options_menu[6] = mi(-1, "", r_none, 0)
        options_menu[7] = mi(1, "M_SVOL", r_sound, 's')
        options_def = menudef { numitems = 8, prev = &main_def, items = options_menu.ptr, routine = d_options, x = 60, y = 37 }
        read_menu1[0] = mi(1, "", r_read_this2, 0)
        read_def1 = menudef { numitems = 1, prev = &main_def, items = read_menu1.ptr, routine = d_read_this1, x = 280, y = 185 }
        read_menu2[0] = mi(1, "", r_finish_read_this, 0)
        read_def2 = menudef { numitems = 1, prev = &read_def1, items = read_menu2.ptr, routine = d_read_this2, x = 330, y = 175 }
        sound_menu[0] = mi(2, "M_SFXVOL", r_sfx_vol, 's')
        sound_menu[1] = mi(-1, "", r_none, 0)
        sound_menu[2] = mi(2, "M_MUSVOL", r_music_vol, 'm')
        sound_menu[3] = mi(-1, "", r_none, 0)
        sound_def = menudef { numitems = 4, prev = &options_def, items = sound_menu.ptr, routine = d_sound, x = 80, y = 64 }
        for k in 0..6 do
            load_menu[k] = mi(1, "", r_load_select, '1' + (i32) k)
            save_menu[k] = mi(1, "", r_save_select, '1' + (i32) k)
        load_def = menudef { numitems = 6, prev = &main_def, items = load_menu.ptr, routine = d_load, x = 80, y = 54 }
        save_def = menudef { numitems = 6, prev = &main_def, items = save_menu.ptr, routine = d_save, x = 80, y = 54 }

    let item = (menu: menudef*, n: i32) -> menu.items + n

    // savegamestrings[10][SAVESTRINGSIZE]
    let save_string = (slot: i32) -> savegamestrings[slot * savestringsize .. slot * savestringsize + savestringsize]
    let save_string_view = (slot: i32) -> c.name_view(savegamestrings.ptr + slot * savestringsize, savestringsize)

    let set_save_string = (slot: i32, text: const str) ->
        let s = save_string(slot)
        for k in 0..savestringsize do s[k] = if k < text.len then text[k] else 0u8

    // read the strings from the savegame files
    let read_save_strings = () ->
        for k in 0..6 do
            let name = misc.save_name((i32) k)
            defer free(name)
            let f = cstdio.fopen(alloca((cstr) name), c"rb")
            if c.is_null(f) then
                set_save_string((i32) k, dstr.emptystring)
                load_menu[k].status = 0
            else
                let s = save_string((i32) k)
                ignore cstdio.fread((any*) s.ptr, 1usize, (usize) savestringsize, f)
                ignore cstdio.fclose(f)
                load_menu[k].status = 1

    let draw_load = () ->
        v.draw_patch_direct(72, 28, 0, v.patch_named("M_LOADG"))
        for k in 0..6 do
            draw_save_load_border(load_def.x, load_def.y + lineheight * (i32) k)
            write_text(load_def.x, load_def.y + lineheight * (i32) k, save_string_view((i32) k))

    // Draw border for the savegame description
    let draw_save_load_border = (x0: i32, y: i32) ->
        let mut x = x0
        v.draw_patch_direct(x - 8, y + 7, 0, v.patch_named("M_LSLEFT"))
        for _ in 0..24 do
            v.draw_patch_direct(x, y + 7, 0, v.patch_named("M_LSCNTR"))
            x = x + 8
        v.draw_patch_direct(x, y + 7, 0, v.patch_named("M_LSRGHT"))

    // User wants to load this game
    let load_select = (choice: i32) ->
        let name = misc.save_name(choice)
        defer free(name)
        ds.g_load_game(name)
        clear_menus()

    // Selected from DOOM menu
    let load_game = (choice: i32) ->
        if ds.netgame then
            start_message(dstr.loadnet, mr_none, false)
            return
        setup_next_menu(&load_def)
        read_save_strings()

    let draw_save = () ->
        v.draw_patch_direct(72, 28, 0, v.patch_named("M_SAVEG"))
        for k in 0..6 do
            draw_save_load_border(load_def.x, load_def.y + lineheight * (i32) k)
            write_text(load_def.x, load_def.y + lineheight * (i32) k, save_string_view((i32) k))
        if save_string_enter then
            let wd = string_width(save_string_view(save_slot))
            write_text(load_def.x + wd, load_def.y + lineheight * save_slot, "_")

    let do_save = (slot: i32) ->
        ds.g_save_game(slot, save_string_view(slot))
        clear_menus()
        // PICK QUICKSAVE SLOT YET?
        if quick_save_slot == -2 then quick_save_slot = slot

    // User wants to save. Start string input for M_Responder
    let save_select = (choice: i32) ->
        // we are going to be intercepting all chars
        save_string_enter = true
        save_slot = choice
        let s = save_string(choice)
        for k in 0..savestringsize do save_old_string[k] = s[k]
        if save_string_view(choice) == dstr.emptystring then s[0] = 0u8
        save_char_index = (i32) save_string_view(choice).len

    // Selected from DOOM menu
    let save_game = (choice: i32) ->
        if !ds.usergame then
            start_message(dstr.savedead, mr_none, false)
            return
        if ds.gamestate != gs.level then return
        setup_next_menu(&save_def)
        read_save_strings()

    // M_QuickSave
    let quick_save_response = (ch: i32) ->
        if ch == 'y' then
            do_save(quick_save_slot)
            snd.start_sound(default(any*), sfx.swtchx)

    // the prompts carry a %s (dstr has them with the slot filled in by hand)
    let fill_prompt = (fmt: const str, arg: const str) ->
        let mut cut = -1
        for k in 0..fmt.len - 1 do
            if cut == -1 && fmt[k] == '%' && fmt[k + 1] == 's' then cut = (i32) k
        if tempstring.len > 0 then free(tempstring)
        tempstring = if cut < 0 then alloc("%s{fmt}")!
                     else alloc("%s{fmt[0..cut]}%s{arg}%s{fmt[cut + 2..]}")!
        (const str) tempstring

    let quick_save = () ->
        if !ds.usergame then
            snd.start_sound(default(any*), sfx.oof)
            return
        if ds.gamestate != gs.level then return
        if quick_save_slot < 0 then
            start_control_panel()
            read_save_strings()
            setup_next_menu(&save_def)
            quick_save_slot = -2    // means to pick a slot now
            return
        start_message(fill_prompt(dstr.qsprompt, save_string_view(quick_save_slot)), mr_quick_save, true)

    // M_QuickLoad
    let quick_load_response = (ch: i32) ->
        if ch == 'y' then
            load_select(quick_save_slot)
            snd.start_sound(default(any*), sfx.swtchx)

    let quick_load = () ->
        if ds.netgame then
            start_message(dstr.qloadnet, mr_none, false)
            return
        if quick_save_slot < 0 then
            start_message(dstr.qsavespot, mr_none, false)
            return
        start_message(fill_prompt(dstr.qlprompt, save_string_view(quick_save_slot)), mr_quick_load, true)

    // Read This Menus. Had a "quick hack to fix romero bug"
    let draw_read_this1 = () ->
        ds.inhelpscreens = true
        let gm = ds.gamemode
        if gm == gmode.commercial then v.draw_patch_direct(0, 0, 0, v.patch_named("HELP"))
        else if gm == gmode.shareware || gm == gmode.registered || gm == gmode.retail then
            v.draw_patch_direct(0, 0, 0, v.patch_named("HELP1"))

    // Read This Menus - optional second page.
    let draw_read_this2 = () ->
        ds.inhelpscreens = true
        let gm = ds.gamemode
        if gm == gmode.retail || gm == gmode.commercial then
            // This hack keeps us from having to change menus.
            v.draw_patch_direct(0, 0, 0, v.patch_named("CREDIT"))
        else if gm == gmode.shareware || gm == gmode.registered then
            v.draw_patch_direct(0, 0, 0, v.patch_named("HELP2"))

    // Change Sfx & Music volumes
    let draw_sound = () ->
        v.draw_patch_direct(60, 38, 0, v.patch_named("M_SVOL"))
        draw_thermo(sound_def.x, sound_def.y + lineheight * (sfx_vol + 1), 16, ds.snd_sfxvolume)
        draw_thermo(sound_def.x, sound_def.y + lineheight * (music_vol + 1), 16, ds.snd_musicvolume)

    let sound = (choice: i32) -> setup_next_menu(&sound_def)

    let sfx_volume = (choice: i32) ->
        if choice == 0 then
            if ds.snd_sfxvolume != 0 then ds.snd_sfxvolume = ds.snd_sfxvolume - 1
        else if choice == 1 then
            if ds.snd_sfxvolume < 15 then ds.snd_sfxvolume = ds.snd_sfxvolume + 1
        snd.set_sfx_volume(ds.snd_sfxvolume)

    let music_volume = (choice: i32) ->
        if choice == 0 then
            if ds.snd_musicvolume != 0 then ds.snd_musicvolume = ds.snd_musicvolume - 1
        else if choice == 1 then
            if ds.snd_musicvolume < 15 then ds.snd_musicvolume = ds.snd_musicvolume + 1
        snd.set_music_volume(ds.snd_musicvolume)

    let draw_main_menu = () -> v.draw_patch_direct(94, 2, 0, v.patch_named("M_DOOM"))

    let draw_new_game = () ->
        v.draw_patch_direct(96, 14, 0, v.patch_named("M_NEWG"))
        v.draw_patch_direct(54, 38, 0, v.patch_named("M_SKILL"))

    let new_game = (choice: i32) ->
        if ds.netgame && !ds.demoplayback then
            start_message(dstr.newgame, mr_none, false)
            return
        if ds.gamemode == gmode.commercial then setup_next_menu(&new_def)
        else setup_next_menu(&epi_def)

    let draw_episode = () -> v.draw_patch_direct(54, 38, 0, v.patch_named("M_EPISOD"))

    let verify_nightmare = (ch: i32) ->
        if ch != 'y' then return
        ds.g_defered_init_new(nightmare, epi + 1, 1)
        clear_menus()

    let choose_skill = (choice: i32) ->
        if choice == nightmare then
            start_message(dstr.nightmare, mr_verify_nightmare, true)
            return
        ds.g_defered_init_new(choice, epi + 1, 1)
        clear_menus()

    let episode = (choice0: i32) ->
        let mut choice = choice0
        if ds.gamemode == gmode.shareware && choice != 0 then
            start_message(dstr.swstring, mr_none, false)
            setup_next_menu(&read_def1)
            return
        // Yet another hack...
        if ds.gamemode == gmode.registered && choice > 2 then
            ignore cstdio.fputs(c"M_Episode: 4th episode requires UltimateDOOM\n", stderr)
            choice = 0
        epi = choice
        setup_next_menu(&new_def)

    let draw_options = () ->
        v.draw_patch_direct(108, 15, 0, v.patch_named("M_OPTTTL"))
        // the render scale, in the HUD font (there are no patches for it)
        let pref = iv.effective_pref()
        let code = if pref != 0 then iv.clamp_code(pref)
                   else if iv.want_native then iv.native_code + iv.want_hires else iv.want_hires
        let n = iv.code_factor(code)
        let suffix = iv.code_suffix(code)
        let label = if pref == 0 then alloca("AUTO %d{n}X%s{suffix}") else alloca("%d{n}X%s{suffix}")
        write_text(options_def.x + 177, options_def.y + lineheight * detail + 6, label)
        v.draw_patch_direct(options_def.x + 120, options_def.y + lineheight * messages, 0,
                            v.patch_named(msg_names[ds.show_messages]))
        draw_thermo(options_def.x, options_def.y + lineheight * (mousesens + 1), 10, ds.mouse_sensitivity)
        draw_thermo(options_def.x, options_def.y + lineheight * (scrnsize + 1), 9, screen_size)

    let options = (choice: i32) -> setup_next_menu(&options_def)

    // Toggle messages on/off
    let change_messages = (choice: i32) ->
        ds.show_messages = 1 - ds.show_messages
        if ds.show_messages == 0 then ds.players[ds.consoleplayer].message = dstr.msgoff
        else ds.players[ds.consoleplayer].message = dstr.msgon
        hu.message_dontfuckwithme = true

    // M_EndGame
    let end_game_response = (ch: i32) ->
        if ch != 'y' then return
        current_menu.laston = item_on
        clear_menus()
        d_start_title()

    let end_game = (choice: i32) ->
        if !ds.usergame then
            snd.start_sound(default(any*), sfx.oof)
            return
        if ds.netgame then
            start_message(dstr.netend, mr_none, false)
            return
        start_message(dstr.endgame, mr_end_game, true)

    // M_ReadThis
    let read_this = (choice: i32) -> setup_next_menu(&read_def1)
    let read_this2 = (choice: i32) -> setup_next_menu(&read_def2)
    let finish_read_this = (choice: i32) -> setup_next_menu(&main_def)

    // M_QuitDOOM
    let quit_response = (ch: i32) ->
        if ch != 'y' then return
        if !ds.netgame then
            if ds.gamemode == gmode.commercial then snd.start_sound(default(any*), quitsounds2[(ds.gametic >> 2) & 7])
            else snd.start_sound(default(any*), quitsounds[(ds.gametic >> 2) & 7])
            // wait a bit for the sound (I_WaitVBL(105))
            if !iv.headless then i.sleep_ms(1500)
        i_quit()

    let quit_doom = (choice: i32) ->
        let msg = if ds.gamemode == gmode.commercial then endmsg2[ds.gametic % 7] else endmsg1[ds.gametic % 7]
        if endstring.len > 0 then free(endstring)
        endstring = alloc("%s{msg}\n\n%s{dstr.dosy}")!
        start_message(endstring, mr_quit, true)

    let change_sensitivity = (choice: i32) ->
        if choice == 0 then
            if ds.mouse_sensitivity != 0 then ds.mouse_sensitivity = ds.mouse_sensitivity - 1
        else if choice == 1 then
            if ds.mouse_sensitivity < 9 then ds.mouse_sensitivity = ds.mouse_sensitivity + 1

    // Render scale: Auto, 1x..12x with native 4:3 after 5x and 10x,
    // wrapping both ways as wolf-fc's picker does. A pinned factor ignores
    // -maxscale. Takes effect at the next frame.
    let change_scale = (choice: i32) ->
        let dir = if choice == 0 then -1 else 1
        iv.scale_factor = iv.next_code(iv.effective_pref(), dir)
        iv.scale_override = -1
        iv.repick()

    let change_detail = (choice: i32) ->
        ds.detail_level = 1 - ds.detail_level
        // FIXME - does not work. Remove anyway?
        ignore cstdio.fputs(c"M_ChangeDetail: low detail mode n.a.\n", stderr)

    let size_display = (choice: i32) ->
        if choice == 0 then
            if screen_size > 0 then
                ds.screenblocks = ds.screenblocks - 1
                screen_size = screen_size - 1
        else if choice == 1 then
            if screen_size < 8 then
                ds.screenblocks = ds.screenblocks + 1
                screen_size = screen_size + 1
        r.set_view_size(ds.screenblocks, ds.detail_level)

    // Menu Functions
    let draw_thermo = (x: i32, y: i32, therm_width: i32, therm_dot: i32) ->
        let mut xx = x
        v.draw_patch_direct(xx, y, 0, v.patch_named("M_THERML"))
        xx = xx + 8
        for _ in 0..therm_width do
            v.draw_patch_direct(xx, y, 0, v.patch_named("M_THERMM"))
            xx = xx + 8
        v.draw_patch_direct(xx, y, 0, v.patch_named("M_THERMR"))
        v.draw_patch_direct((x + 8) + therm_dot * 8, y, 0, v.patch_named("M_THERMO"))

    let start_message = (string: const str, routine: i32, input: bool) ->
        message_last_menu_active = ds.menuactive
        message_to_print = 1
        message_string = string
        message_routine = routine
        message_needs_input = input
        ds.menuactive = true

    let stop_message = () ->
        ds.menuactive = message_last_menu_active
        message_to_print = 0

    // Find string width from hu_font chars
    let string_width = (string: const str) ->
        let mut wd = 0
        for ch in string do
            let cc = (i32) c.toupper(ch) - hu.fontstart
            if cc < 0 || cc >= hu.fontsize then wd = wd + 4
            else wd = wd + (i32) hulib.font[cc].width
        wd

    // Find string height from hu_font chars
    let string_height = (string: const str) ->
        let height = (i32) hulib.font[0].height
        let mut h = height
        for ch in string do
            if ch == '\n' then h = h + height
        h

    // Write a string using the hu_font
    let write_text = (x: i32, y: i32, string: const str) ->
        let mut cx = x
        let mut cy = y
        for ch in string do
            if ch == 0u8 then break
            if ch == '\n' then
                cx = x
                cy = cy + 12
                continue
            let cc = (i32) c.toupper(ch) - hu.fontstart
            if cc < 0 || cc >= hu.fontsize then
                cx = cx + 4
                continue
            let wd = (i32) hulib.font[cc].width
            if cx + wd > 320 then break
            v.draw_patch_direct(cx, cy, 0, hulib.font[cc])
            cx = cx + wd

    let call_routine = (rt: i32, choice: i32) ->
        match rt with
        | 1 -> new_game(choice)
        | 2 -> options(choice)
        | 3 -> load_game(choice)
        | 4 -> save_game(choice)
        | 5 -> read_this(choice)
        | 6 -> quit_doom(choice)
        | 7 -> episode(choice)
        | 8 -> choose_skill(choice)
        | 9 -> end_game(choice)
        | 10 -> change_messages(choice)
        | 11 -> change_detail(choice)
        | 12 -> size_display(choice)
        | 13 -> change_sensitivity(choice)
        | 14 -> sound(choice)
        | 15 -> read_this2(choice)
        | 16 -> finish_read_this(choice)
        | 17 -> sfx_volume(choice)
        | 18 -> music_volume(choice)
        | 19 -> load_select(choice)
        | 20 -> save_select(choice)
        | 21 -> change_scale(choice)
        | _ -> void()

    let call_message_routine = (rt: i32, ch: i32) ->
        match rt with
        | 1 -> quick_save_response(ch)
        | 2 -> quick_load_response(ch)
        | 3 -> verify_nightmare(ch)
        | 4 -> end_game_response(ch)
        | 5 -> quit_response(ch)
        | _ -> void()

    let call_drawer = (d: i32) ->
        match d with
        | 1 -> draw_main_menu()
        | 2 -> draw_episode()
        | 3 -> draw_new_game()
        | 4 -> draw_options()
        | 5 -> draw_read_this1()
        | 6 -> draw_read_this2()
        | 7 -> draw_sound()
        | 8 -> draw_load()
        | 9 -> draw_save()
        | _ -> void()

    let mut mousewait = 0
    let mut mouse_my = 0
    let mut lasty = 0
    let mut mouse_mx = 0
    let mut lastx = 0

    let responder = (ev: event*) ->
        let mut ch = -1
        if ev.type == evt.mouse && mousewait < i.get_time() then
            mouse_my = mouse_my + ev.data3
            if mouse_my < lasty - 30 then
                ch = dd.key_downarrow
                mousewait = i.get_time() + 5
                lasty = lasty - 30
                mouse_my = lasty
            else if mouse_my > lasty + 30 then
                ch = dd.key_uparrow
                mousewait = i.get_time() + 5
                lasty = lasty + 30
                mouse_my = lasty
            mouse_mx = mouse_mx + ev.data2
            if mouse_mx < lastx - 30 then
                ch = dd.key_leftarrow
                mousewait = i.get_time() + 5
                lastx = lastx - 30
                mouse_mx = lastx
            else if mouse_mx > lastx + 30 then
                ch = dd.key_rightarrow
                mousewait = i.get_time() + 5
                lastx = lastx + 30
                mouse_mx = lastx
            if (ev.data1 & 1) != 0 then
                ch = dd.key_enter
                mousewait = i.get_time() + 15
            if (ev.data1 & 2) != 0 then
                ch = dd.key_backspace
                mousewait = i.get_time() + 15
        else if ev.type == evt.keydown then
            ch = ev.data1
        if ch == -1 then return false
        // Save Game string input
        if save_string_enter then
            let s = save_string(save_slot)
            if ch == dd.key_backspace then
                if save_char_index > 0 then
                    save_char_index = save_char_index - 1
                    s[save_char_index] = 0u8
            else if ch == dd.key_escape then
                save_string_enter = false
                for k in 0..savestringsize do s[k] = save_old_string[k]
            else if ch == dd.key_enter then
                save_string_enter = false
                if s[0] != 0u8 then do_save(save_slot)
            else
                let uc = if ch >= 0 && ch < 256 then (i32) c.toupper((u8) ch) else ch
                let ok_char = uc == 32 || (uc - hu.fontstart >= 0 && uc - hu.fontstart < hu.fontsize)
                if ok_char && uc >= 32 && uc <= 127 && save_char_index < savestringsize - 1
                    && string_width(save_string_view(save_slot)) < (savestringsize - 2) * 8 then
                    s[save_char_index] = (u8) uc
                    save_char_index = save_char_index + 1
                    s[save_char_index] = 0u8
            return true
        // Take care of any messages that need input
        if message_to_print != 0 then
            if message_needs_input && !(ch == ' ' || ch == 'n' || ch == 'y' || ch == dd.key_escape) then
                return false
            ds.menuactive = message_last_menu_active
            message_to_print = 0
            call_message_routine(message_routine, ch)
            ds.menuactive = false
            snd.start_sound(default(any*), sfx.swtchx)
            return true
        if ds.devparm && ch == dd.key_f1 then
            ds.gameaction = ga.screenshot
            return true
        // F-Keys
        if !ds.menuactive then
            if ch == dd.key_minus then
                // Screen size down
                if ds.automapactive || hu.chat_on then return false
                size_display(0)
                snd.start_sound(default(any*), sfx.stnmov)
                return true
            else if ch == dd.key_equals then
                // Screen size up
                if ds.automapactive || hu.chat_on then return false
                size_display(1)
                snd.start_sound(default(any*), sfx.stnmov)
                return true
            else if ch == dd.key_f1 then
                // Help key
                start_control_panel()
                if ds.gamemode == gmode.retail then current_menu = &read_def2
                else current_menu = &read_def1
                item_on = 0
                snd.start_sound(default(any*), sfx.swtchn)
                return true
            else if ch == dd.key_f2 then
                // Save
                start_control_panel()
                snd.start_sound(default(any*), sfx.swtchn)
                save_game(0)
                return true
            else if ch == dd.key_f3 then
                // Load
                start_control_panel()
                snd.start_sound(default(any*), sfx.swtchn)
                load_game(0)
                return true
            else if ch == dd.key_f4 then
                // Sound Volume
                start_control_panel()
                current_menu = &sound_def
                item_on = sfx_vol
                snd.start_sound(default(any*), sfx.swtchn)
                return true
            else if ch == dd.key_f5 then
                // Detail toggle
                change_detail(0)
                snd.start_sound(default(any*), sfx.swtchn)
                return true
            else if ch == dd.key_f6 then
                // Quicksave
                snd.start_sound(default(any*), sfx.swtchn)
                quick_save()
                return true
            else if ch == dd.key_f7 then
                // End game
                snd.start_sound(default(any*), sfx.swtchn)
                end_game(0)
                return true
            else if ch == dd.key_f8 then
                // Toggle messages
                change_messages(0)
                snd.start_sound(default(any*), sfx.swtchn)
                return true
            else if ch == dd.key_f9 then
                // Quickload
                snd.start_sound(default(any*), sfx.swtchn)
                quick_load()
                return true
            else if ch == dd.key_f10 then
                // Quit DOOM
                snd.start_sound(default(any*), sfx.swtchn)
                quit_doom(0)
                return true
            else if ch == dd.key_f11 then
                // gamma toggle
                ds.usegamma = ds.usegamma + 1
                if ds.usegamma > 4 then ds.usegamma = 0
                ds.players[ds.consoleplayer].message = gammamsg[ds.usegamma]
                iv.set_palette(w.cache_lump_name("PLAYPAL", pu.cache))
                return true
        // Pop-up menu?
        if !ds.menuactive then
            if ch == dd.key_escape then
                start_control_panel()
                snd.start_sound(default(any*), sfx.swtchn)
                return true
            return false
        // Keys usable within menu
        let cur = item(current_menu, item_on)
        if ch == dd.key_downarrow then
            loop
                if item_on + 1 > current_menu.numitems - 1 then item_on = 0
                else item_on = item_on + 1
                snd.start_sound(default(any*), sfx.pstop)
                if item(current_menu, item_on).status != -1 then break
            return true
        else if ch == dd.key_uparrow then
            loop
                if item_on == 0 then item_on = current_menu.numitems - 1
                else item_on = item_on - 1
                snd.start_sound(default(any*), sfx.pstop)
                if item(current_menu, item_on).status != -1 then break
            return true
        else if ch == dd.key_leftarrow then
            if cur.routine != r_none && cur.status == 2 then
                snd.start_sound(default(any*), sfx.stnmov)
                call_routine(cur.routine, 0)
            return true
        else if ch == dd.key_rightarrow then
            if cur.routine != r_none && cur.status == 2 then
                snd.start_sound(default(any*), sfx.stnmov)
                call_routine(cur.routine, 1)
            return true
        else if ch == dd.key_enter then
            if cur.routine != r_none && cur.status != 0 then
                current_menu.laston = item_on
                if cur.status == 2 then
                    call_routine(cur.routine, 1)    // right arrow
                    snd.start_sound(default(any*), sfx.stnmov)
                else
                    call_routine(cur.routine, item_on)
                    snd.start_sound(default(any*), sfx.pistol)
            return true
        else if ch == dd.key_escape then
            current_menu.laston = item_on
            clear_menus()
            snd.start_sound(default(any*), sfx.swtchx)
            return true
        else if ch == dd.key_backspace then
            current_menu.laston = item_on
            if c.not_null(current_menu.prev) then
                current_menu = current_menu.prev
                item_on = current_menu.laston
                snd.start_sound(default(any*), sfx.swtchn)
            return true
        else
            for k in item_on + 1..current_menu.numitems do
                if item(current_menu, (i32) k).alphakey == ch then
                    item_on = (i32) k
                    snd.start_sound(default(any*), sfx.pstop)
                    return true
            for k in 0..item_on + 1 do
                if item(current_menu, (i32) k).alphakey == ch then
                    item_on = (i32) k
                    snd.start_sound(default(any*), sfx.pstop)
                    return true
        false

    let start_control_panel = () ->
        // intro might call this repeatedly
        if ds.menuactive then return
        ds.menuactive = true
        current_menu = &main_def    // JDC
        item_on = current_menu.laston    // JDC

    // Called after the view has been rendered, but before it has been
    // blitted.
    let drawer = () ->
        ds.inhelpscreens = false
        // Horiz. & Vertically center string and print it.
        if message_to_print != 0 then
            let ms = message_string
            let mut y = 100 - string_height(ms) / 2
            let mut start = 0i64
            loop
                if start >= ms.len then break
                let mut k = start
                loop
                    if k >= ms.len || ms[k] == '\n' then break
                    k = k + 1
                let line = ms[start..k]
                start = if k < ms.len then k + 1 else k
                let x = 160 - string_width(line) / 2
                write_text(x, y, line)
                y = y + (i32) hulib.font[0].height
            return
        if !ds.menuactive then return
        if current_menu.routine != 0 then call_drawer(current_menu.routine)    // call Draw routine
        // DRAW MENU
        let x = current_menu.x
        let mut y = current_menu.y
        for k in 0..current_menu.numitems do
            let it0 = item(current_menu, (i32) k)
            if it0.name.len > 0 then v.draw_patch_direct(x, y, 0, v.patch_named(it0.name))
            y = y + lineheight
        // DRAW SKULL
        v.draw_patch_direct(x + skullxoff, current_menu.y - 5 + item_on * lineheight, 0,
                            v.patch_named(skull_name[which_skull]))

    let clear_menus = () ->
        ds.menuactive = false

    let setup_next_menu = (menu: menudef*) ->
        current_menu = menu
        item_on = current_menu.laston

    let ticker = () ->
        skull_anim_counter = skull_anim_counter - 1
        if skull_anim_counter <= 0 then
            which_skull = which_skull ^ 1
            skull_anim_counter = 8

    let init = () ->
        build_menus()
        current_menu = &main_def
        ds.menuactive = false
        item_on = current_menu.laston
        which_skull = 0
        skull_anim_counter = 10
        screen_size = ds.screenblocks - 3
        message_to_print = 0
        message_string = ""
        message_last_menu_active = ds.menuactive
        quick_save_slot = -1
        // Here we could catch other version dependencies,
        // like HELP1/2, and four episodes.
        let gm = ds.gamemode
        if gm == gmode.commercial then
            // This is used because DOOM 2 had only one HELP
            //  page. I use CREDIT as second page now, but
            //  kept this hack for educational purposes.
            main_menu[readthis] = main_menu[quitdoom]
            main_def.numitems = main_def.numitems - 1
            main_def.y = main_def.y + 8
            new_def.prev = &main_def
            read_def1.routine = d_read_this1
            read_def1.x = 330
            read_def1.y = 165
            read_menu1[0].routine = r_finish_read_this
        else if gm == gmode.shareware || gm == gmode.registered then
            // We need to remove the fourth episode.
            epi_def.numitems = epi_def.numitems - 1
