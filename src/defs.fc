// Shared Doom vocabulary: fixed-point math (m_fixed), the doomdef.h /
// d_*.h / p_*.h / r_defs.h constants and every struct the engine passes
// between subsystems. Ported from id Software's linuxdoom-1.10 (GPLv2).
//
// Structs are top-level so that every module sees them; C enums that the
// engine does arithmetic on (weapons, ammo, gamestates, ...) are i32
// constants in small modules named after the C prefix (wp.pistol for
// wp_pistol, gs.level for GS_LEVEL, ...). In-memory `short` fields widen to
// i32; the on-disk map formats are decoded explicitly in p_setup.

// ------------------------------------------------------------------
// m_fixed: 16.16 fixed point
// ------------------------------------------------------------------
module fx =
    let fracbits = 16
    let fracunit = 65536

    let mul = (a: i32, b: i32) -> (i32) (((i64) a * b) >> 16)

    let div2 = (a: i32, b: i32) ->
        let cc = (f64) a / (f64) b * 65536.0
        if cc >= 2147483648.0 || cc < -2147483648.0 then
            i.fatal("FixedDiv: divide by zero")
        (i32) cc

    let div = (a: i32, b: i32) ->
        if (c.iabs(a) >> 14) >= c.iabs(b) then
            if (a ^ b) < 0 then i32.min else i32.max
        else div2(a, b)

    // Binary angles (tables.h)
    let ang45 = 0x20000000u32
    let ang90 = 0x40000000u32
    let ang180 = 0x80000000u32
    let ang270 = 0xc0000000u32

    // angle_t -> fine-table index
    let fine = (a: u32) -> (i32) (a >> 19)

// ------------------------------------------------------------------
// doomdef.h
// ------------------------------------------------------------------
module dd =
    // Demo / savegame version byte. linuxdoom says 110, but its playsim is
    // the v1.9 one, so we write 109 to play the IWADs' own demos.
    let version = 109
    let screenwidth = 320
    let screenheight = 200
    let maxplayers = 4
    let ticrate = 35

    let mtf_easy = 1
    let mtf_normal = 2
    let mtf_hard = 4
    let mtf_ambush = 8

    let key_rightarrow = 0xae
    let key_leftarrow = 0xac
    let key_uparrow = 0xad
    let key_downarrow = 0xaf
    let key_escape = 27
    let key_enter = 13
    let key_tab = 9
    let key_f1 = 0x80 + 0x3b
    let key_f2 = 0x80 + 0x3c
    let key_f3 = 0x80 + 0x3d
    let key_f4 = 0x80 + 0x3e
    let key_f5 = 0x80 + 0x3f
    let key_f6 = 0x80 + 0x40
    let key_f7 = 0x80 + 0x41
    let key_f8 = 0x80 + 0x42
    let key_f9 = 0x80 + 0x43
    let key_f10 = 0x80 + 0x44
    let key_f11 = 0x80 + 0x57
    let key_f12 = 0x80 + 0x58
    let key_backspace = 127
    let key_pause = 0xff
    let key_equals = 0x3d
    let key_minus = 0x2d
    let key_rshift = 0x80 + 0x36
    let key_rctrl = 0x80 + 0x1d
    let key_ralt = 0x80 + 0x38
    let key_lalt = key_ralt

