    count: i32
    minlight: i32
    maxlight: i32
    darktime: i32
    brighttime: i32

struct glow =
    thinker: thinker
    sector: sector*
    minlight: i32
    maxlight: i32
    direction: i32

struct button =
    line: line*
    where: i32
    btexture: i32
    btimer: i32
    soundorg: mobj*

struct plat =
    thinker: thinker
    sector: sector*
    speed: i32
    low: i32
    high: i32
    wait: i32
    count: i32
    status: i32
    oldstatus: i32
    crush: bool
    tag: i32
    type: i32

struct vldoor =
    thinker: thinker
    type: i32
    sector: sector*
    topheight: i32
    speed: i32
    direction: i32
    topwait: i32
    topcountdown: i32

struct ceiling =
    thinker: thinker
    type: i32
    sector: sector*
    bottomheight: i32
    topheight: i32
    speed: i32
    crush: bool
    direction: i32
    tag: i32
    olddirection: i32

struct floormove =
    thinker: thinker
    type: i32
    crush: bool
    sector: sector*
    direction: i32
    newspecial: i32
    texture: i32
    floordestheight: i32
    speed: i32

struct anim =
    istexture: bool
    picnum: i32
    basepic: i32
    numpics: i32
    speed: i32

struct weaponinfo =
    ammo: i32
    upstate: i32
    downstate: i32
    readystate: i32
    atkstate: i32
    flashstate: i32

// ------------------------------------------------------------------
// d_items.c
// ------------------------------------------------------------------
module items =
    let weaponinfo = weaponinfo[] {
        // fist
        weaponinfo { ammo = am.noammo, upstate = sn.punchup, downstate = sn.punchdown,
                     readystate = sn.punch, atkstate = sn.punch1, flashstate = sn.null },
        // pistol
        weaponinfo { ammo = am.clip, upstate = sn.pistolup, downstate = sn.pistoldown,
                     readystate = sn.pistol, atkstate = sn.pistol1, flashstate = sn.pistolflash },
        // shotgun
        weaponinfo { ammo = am.shell, upstate = sn.sgunup, downstate = sn.sgundown,
                     readystate = sn.sgun, atkstate = sn.sgun1, flashstate = sn.sgunflash1 },
        // chaingun
        weaponinfo { ammo = am.clip, upstate = sn.chainup, downstate = sn.chaindown,
                     readystate = sn.chain, atkstate = sn.chain1, flashstate = sn.chainflash1 },
        // missile launcher
        weaponinfo { ammo = am.misl, upstate = sn.missileup, downstate = sn.missiledown,
                     readystate = sn.missile, atkstate = sn.missile1, flashstate = sn.missileflash1 },
        // plasma rifle
        weaponinfo { ammo = am.cell, upstate = sn.plasmaup, downstate = sn.plasmadown,
                     readystate = sn.plasma, atkstate = sn.plasma1, flashstate = sn.plasmaflash1 },
        // bfg 9000
        weaponinfo { ammo = am.cell, upstate = sn.bfgup, downstate = sn.bfgdown,
                     readystate = sn.bfg, atkstate = sn.bfg1, flashstate = sn.bfgflash1 },
        // chainsaw
        weaponinfo { ammo = am.noammo, upstate = sn.sawup, downstate = sn.sawdown,
                     readystate = sn.saw, atkstate = sn.saw1, flashstate = sn.null },
        // super shotgun
        weaponinfo { ammo = am.shell, upstate = sn.dsgunup, downstate = sn.dsgundown,
                     readystate = sn.dsgun, atkstate = sn.dsgun1, flashstate = sn.dsgunflash1 }
    }
