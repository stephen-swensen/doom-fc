// bounding-box indices (m_bbox.h)
module box =
    let top = 0
    let bottom = 1
    let left = 2
    let right = 3

    let clear = (b: i32[]) ->
        b[top] = i32.min
        b[right] = i32.min
        b[bottom] = i32.max
        b[left] = i32.max

    let add = (b: i32[], x: i32, y: i32) ->
        if x < b[left] then b[left] = x
        else if x > b[right] then b[right] = x
        if y < b[bottom] then b[bottom] = y
        else if y > b[top] then b[top] = y

// ------------------------------------------------------------------
// Thinkers (d_think.h). The C version stores a function pointer; we
// store which thinker routine runs, and p.run_thinkers dispatches.
// `nil` is the C NULL (a ceiling/plat in stasis), `removed` the -1
// marker P_RemoveThinker leaves for deferred freeing.
// ------------------------------------------------------------------
enum thinkf =
    | nil
    | removed
    | mobj
    | move_ceiling
    | vertical_door
    | move_floor
    | plat_raise
    | light_flash
    | strobe_flash
    | glow
    | fire_flicker

struct thinker =
    prev: thinker*
    next: thinker*
    function: thinkf

struct ticcmd =
    forwardmove: i8
    sidemove: i8
    angleturn: i16
    consistancy: i16
    chatchar: u8
    buttons: u8

struct event =
    type: i32
    data1: i32
    data2: i32
    data3: i32

struct mapthing =
    x: i32
    y: i32
    angle: i32
    type: i32
    options: i32

// Where a mobj was at the start of the last tic, for frame interpolation
// (see interp.fc). `snap` is the snapshot it belongs to; 0 means none, so
// a new or teleported mobj is drawn where it is. Not saved: savegames
// store a mobj without it (p.saved_mobj_size), so it must stay last in
// mobj and a multiple of 8 bytes.
struct mobj_interp =
    x: i32
    y: i32
    z: i32
    angle: u32
    viewz: i32
    snap: i32

struct mobj =
    thinker: thinker
    x: i32
    y: i32
    z: i32
    snext: mobj*
    sprev: mobj*
    angle: u32
    sprite: i32
    frame: i32
    bnext: mobj*
    bprev: mobj*
    subsector: subsector*
    floorz: i32
    ceilingz: i32
    radius: i32
    height: i32
    momx: i32
    momy: i32
    momz: i32
    validcount: i32
    type: i32
    info: const mobjinfo*
    tics: i32
    state: const state*
    flags: i32
    health: i32
    movedir: i32
    movecount: i32
    target: mobj*
    reactiontime: i32
    threshold: i32
    player: player*
    lastlook: i32
    spawnpoint: mapthing
    tracer: mobj*
    interp: mobj_interp

struct pspdef =
    state: const state*
    tics: i32
    sx: i32
    sy: i32

struct player =
    mo: mobj*
    playerstate: i32
    cmd: ticcmd
    viewz: i32
    viewheight: i32
    deltaviewheight: i32
    bob: i32
    health: i32
    armorpoints: i32
    armortype: i32
    powers: i32[6]
    cards: bool[6]
    backpack: bool
    frags: i32[4]
    readyweapon: i32
    pendingweapon: i32
    weaponowned: bool[9]
    ammo: i32[4]
    maxammo: i32[4]
    attackdown: bool
    usedown: bool
    cheats: i32
    refire: i32
    killcount: i32
    itemcount: i32
    secretcount: i32
    message: const str
    damagecount: i32
    bonuscount: i32
    attacker: mobj*
    extralight: i32
    fixedcolormap: i32
    colormap: i32
    psprites: pspdef[2]
    didsecret: bool

struct wbplayerstruct =
    in_game: bool
    skills: i32
    sitems: i32
    ssecret: i32
    stime: i32
    frags: i32[4]
    score: i32

struct wbstartstruct =
    epsd: i32
    didsecret: bool
    last: i32
    next: i32
    maxkills: i32
    maxitems: i32
    maxsecret: i32
    maxfrags: i32
    partime: i32
    pnum: i32
    plyr: wbplayerstruct[4]

// ------------------------------------------------------------------
// r_defs.h: map geometry and renderer records
// ------------------------------------------------------------------
struct vertex =
    x: i32
    y: i32

// A sector's sound origin: shares mobj's first fields so S_StartSound can
// take it as an mobj*.
struct degenmobj =
    thinker: thinker
    x: i32
    y: i32
    z: i32

struct sector =
    floorheight: i32
    ceilingheight: i32
    floorpic: i32
    ceilingpic: i32
    lightlevel: i32
    special: i32
    tag: i32
    soundtraversed: i32
    soundtarget: mobj*
    blockbox: i32[4]
    soundorg: degenmobj
    validcount: i32
    thinglist: mobj*
    specialdata: any*
    linecount: i32
    lines: line**
    // heights at the start of the last tic (frame interpolation)
    oldfloorheight: i32
    oldceilingheight: i32

struct side =
    textureoffset: i32
    rowoffset: i32
    toptexture: i32
    bottomtexture: i32
    midtexture: i32
    sector: sector*

struct line =
    v1: vertex*
    v2: vertex*
    dx: i32
    dy: i32
    flags: i32
    special: i32
    tag: i32
    sidenum: i32[2]
    bbox: i32[4]
    slopetype: i32
    frontsector: sector*
    backsector: sector*
    validcount: i32
    specialdata: any*

struct subsector =
    sector: sector*
    numlines: i32
    firstline: i32

struct seg =
    v1: vertex*
    v2: vertex*
    offset: i32
    angle: u32
    sidedef: side*
    linedef: line*
    frontsector: sector*
    backsector: sector*

// bbox[2][4] flattened: bbox[side * 4 + box.*]
struct node =
    x: i32
    y: i32
    dx: i32
    dy: i32
    bbox: i32[8]
    children: i32[2]

struct drawseg =
    curline: seg*
    x1: i32
    x2: i32
    scale1: i32
    scale2: i32
    scalestep: i32
    silhouette: i32
    bsilheight: i32
    tsilheight: i32
    sprtopclip: i16*
    sprbottomclip: i16*
    maskedtexturecol: i16*

struct vissprite =
    prev: vissprite*
    next: vissprite*
    x1: i32
    x2: i32
    gx: i32
    gy: i32
    gz: i32
    gzt: i32
    startfrac: i32
    scale: i32
    xiscale: i32
    texturemid: i32
    patch: i32
    colormap: const u8*
    mobjflags: i32

struct spriteframe =
    rotate: i32       // -1 = not yet set (R_InitSprites), else boolean
    lump: i32[8]
    flip: u8[8]

struct spritedef =
    numframes: i32
    spriteframes: spriteframe*

// top/bottom carry one pad byte at each end, so index them with x + 1
// (the C struct's pad1..pad4 serve the same purpose).
struct visplane =
    height: i32
    picnum: i32
    lightlevel: i32
    minx: i32
    maxx: i32
    // per screen column plus a sentinel at each end; 0xffff = unused
    top: u16[]
    bottom: u16[]

// ------------------------------------------------------------------
// p_spec.h thinkers and records
// ------------------------------------------------------------------
struct fireflicker =
    thinker: thinker
    sector: sector*
    count: i32
    maxlight: i32
    minlight: i32

struct lightflash =
    thinker: thinker
    sector: sector*
    count: i32
    maxlight: i32
    minlight: i32
    maxtime: i32
    mintime: i32

struct strobe =
    thinker: thinker
