// s_sound (channel allocation, attenuation, music selection) ported from
// linuxdoom-1.10 (GPLv2), over an SDL2 audio callback that mixes the same
// way linuxdoom's i_sound.c does: 8 channels of the WAD's 8-bit DMX
// samples, volume and stereo separation through the original formula.
// Music lives in music.fc (MUS through an emulated OPL2, as on DOS).

// One mixer channel. Owned by the audio callback: only the audio thread
// reads or writes these (see isnd).
struct sfxchannel =
    data: const u8*?     // the next sample; none: idle
    dataend: const u8*
    step: u32            // 16.16 source samples per output sample
    stepremainder: u32
    leftvol: i32         // 0..127
    rightvol: i32
    handle: i32

module isnd =
    import math from std::
    import opl_midi from shared::

    // A request from the game (main thread) to the audio callback.
    struct sndcmd =
        op: i32              // isnd.op_*
        slot: i32
        handle: i32
        id: i32
        leftvol: i32
        rightvol: i32
        step: u32
        looping: bool
        tune: opl_midi.song


    // How the two threads share the sound system (the wolf-fc design).
    //
    // The main thread never takes SDL's audio lock and never closes the
    // device. On a PipeWire desktop the audio thread can wedge inside the
    // sound server; a main thread waiting on SDL_LockAudioDevice, or on the
    // join inside SDL_CloseAudioDevice / SDL_Quit, then hangs with it, so a
    // dead audio device would freeze the whole game. Instead:
    //
    // - The main thread posts commands (start, stop, set params, music) on
    //   a single-producer / single-consumer ring. The callback drains it at
    //   the top of each buffer and is the only code that touches `chans` and
    //   the music player. A full ring drops the command (a missed sound,
    //   never a stall).
    // - The main thread keeps its own mirror of which handle it last put in
    //   each slot (`slot_handle`); the callback publishes, per slot, the
    //   handle that last finished or was stopped (`finished`). A sound is
    //   playing while the two differ. That is all I_SoundIsPlaying needs.
    // - Music volume crosses as an atomic. Songs are converted on the main
    //   thread, cached for the life of the process (so nothing the callback
    //   may still be reading is ever freed), and handed over by value.
    // - Shutdown leaves the device open for the OS to reap.

    let num_channels = 8
    // The mix runs at the output device's own rate, so SDL does not
    // resample it (wolf-fc's approach): SDL_GetDefaultAudioInfo when the
    // driver can say, else 48000, the PipeWire / modern-desktop norm.
    // Pitch is independent of it: each effect steps through its samples at
    // its own rate / output_rate, and the OPL2 emulator is built for the
    // rate it is given. Headless capture and -musictest pin capture_rate so
    // their output (and the test goldens) stay tic-aligned and fixed.
    let fallback_rate = 48000
    let capture_rate = 44100
    let mut output_rate = 48000
    // 1024 frames: PipeWire's default quantum (~21 ms at 48 kHz)
    let buffer_frames = 1024

    let op_start = 1
    let op_stop = 2
    let op_params = 3
    let op_mus_play = 4
    let op_mus_stop = 5
    let op_mus_pause = 6
    let op_mus_resume = 7

    let mut device = 0u32
    let mut lengths = i32[] { len = 128 }
    let mut sample_rates = i32[] { len = 128 }
    let mut steptable = i32[] { len = 256 }
    let mut pitch_shift = false
    let mut nosound = false
    let mut nomusic = false

    // the ring (main -> audio)
    let ring_size = 256
    let mut ring = sndcmd[] { len = 256 }
    let mut ring_head = 0i64    // advanced only by the audio thread
    let mut ring_tail = 0i64    // advanced only by the main thread

    // audio-thread state
    let mut chans = sfxchannel[] { len = 8 }
    let mut mix_buf = default(i32[])
    let mut finished = i32[] { len = 8 }    // published by the audio thread

    // main-thread state
    let mut slot_handle = i32[] { len = 8 }
    let mut slot_id = i32[] { len = 8 }
    let mut slot_start = i32[] { len = 8 }
    let mut handlenums = 0

    // -headless -sndcapture FILE: no device; the mixer runs one tic's worth
    // of samples per gametic (capture_tic) and the run is written as a WAV.
    let mut capture = false
    let mut cap = default(i16[])
    let mut cap_frames = 0
    let frames_per_tic = capture_rate / 35

    // getsfx: a DMX lump is u16 format, u16 rate, u32 length, then 8-bit
    // unsigned samples.
    let load_sfx = (id: i32) ->
        let sfx = &sounds.s_sfx[id]
        let name = alloca("ds%s{sfx.name}")
        let lump = if w.check_num_for_name(name) == -1 then w.get_num_for_name("dspistol")
                   else w.get_num_for_name(name)
        let size = w.lump_length(lump)
        let raw = w.cache_lump_num(lump, pu.static_x)
        let rate = (i32) mem.rd_u16(raw + 2)
        let mut len = mem.rd_i32(raw + 4)
        if len > size - 8 || len <= 0 then len = size - 8
        sfx.data = u8[] { ptr = raw + 8, len = len }
        lengths[id] = len
        sample_rates[id] = if rate > 0 then rate else 11025

    // I_SetChannels: the pitch step table.
    let set_channels = () ->
        for k in 0..256 do
            steptable[k] = (i32) (math.pow(2.0, (f64) (k - 128) / 64.0) * 65536.0)

    // Bring up SDL audio, preferring the native PipeWire backend: SDL's
    // default order picks pulseaudio first, which on a PipeWire desktop
    // goes through the pipewire-pulse shim, the path where wolf-fc's audio
    // thread wedged. A driver name in the hint is a restriction, not a
    // preference, so on failure clear it and take SDL's default list. The
    // user's SDL_AUDIODRIVER still wins over both.
    let init_sdl_audio = () ->
        ignore sdl2.set_hint(c"SDL_AUDIODRIVER", c"pipewire")
        if sdl2.init(sdl2.init_audio) != 0 then
            ignore sdl2.set_hint(c"SDL_AUDIODRIVER", c"")
            if sdl2.init(sdl2.init_audio) != 0 then return false
        true

    let init = () ->
        set_channels()
        pitch_shift = argv.check_parm("-pitchshift") > 0
        capture = iv.headless && argv.check_parm("-sndcapture") > 0
        nosound = argv.check_parm("-nosound") > 0 || (iv.headless && !capture)
        nomusic = argv.check_parm("-nomusic") > 0 || nosound
        if nosound then return
        for k in 1..sfx.numsfx do
            let sx = &sounds.s_sfx[k]
            if sx.link == -1 then load_sfx(k)
        for k in 1..sfx.numsfx do
            let sx = &sounds.s_sfx[k]
            if sx.link != -1 then
                sx.data = sounds.s_sfx[sx.link].data
                lengths[k] = lengths[sx.link]
                sample_rates[k] = sample_rates[sx.link]
        mix_buf = alloc(i32[] { len = 8192 })!
        if capture then
            output_rate = capture_rate
            cap = alloc(i16[] { len = frames_per_tic * 2 * 35 * 60 })!
            if !nomusic then musplay.init(output_rate)
            return
        if !init_sdl_audio() then
            i.print(alloca("I_InitSound: could not start SDL audio (%s{(const str) sdl2.get_error()})\n"))
            nosound = true
            nomusic = true
            return
        let mut pref = default(sdl2.audio_spec)
        let detected = sdl2.get_default_audio_info(none(cstr*), &pref, 0) == 0 && pref.freq > 0
        output_rate = if detected then pref.freq else fallback_rate
        let spec = sdl2.audio_spec {
            freq = output_rate, format = sdl2.audio_s16sys, channels = 2u8, silence = 0u8,
            samples = (u16) buffer_frames, padding = 0u16, size = 0u32,
            callback = &callback, userdata = none(any*) }
        let mut obtained = default(sdl2.audio_spec)
        // allowed_changes 0: SDL converts to exactly this format and buffer
        device = sdl2.open_audio(none(const cstr), 0, &spec, &obtained, 0)
        if device == 0u32 then
            i.print(alloca("I_InitSound: could not open audio (%s{(const str) sdl2.get_error()})\n"))
            nosound = true
            nomusic = true
        else
            let drvname = match sdl2.get_current_audio_driver() with
            | some(drv) -> (const str) drv
            | none -> (const str) "?"
            let how = if detected then (const str) "" else (const str) " (fallback)"
            let buf_ms = (f64) obtained.samples * 1000.0 / (f64) obtained.freq
            i.print(alloca("I_InitSound: driver %s{drvname}, device rate %d{output_rate} Hz%s{how}, stereo, %d{(i32) obtained.samples}-frame buffer (~%4.1f{buf_ms} ms)\n"))
            // the mix buffer covers the granted buffer, and the player
            // exists, before the callback can run
            if (i64) obtained.samples * 2 > mix_buf.len then
                free(mix_buf)
                mix_buf = alloc(i32[] { len = (i64) obtained.samples * 2 })!
            if !nomusic then musplay.init(output_rate)
            sdl2.pause_audio(device, 0)

    // One gametic of mixed output into the capture buffer. The callback
    // runs on the main thread here, through the same ring.
    let capture_tic = () ->
        if capture then
            if (cap_frames + frames_per_tic) * 2 > (i32) cap.len then
                let bigger = alloc(i16[] { len = cap.len * 2 })!
                for k in 0..cap.len do bigger[k] = cap[k]
                free(cap)
                cap = bigger
            callback(none(any*), (u8*) (cap.ptr + cap_frames * 2), frames_per_tic * 4)
            cap_frames = cap_frames + frames_per_tic

    // I_ShutdownSound: deliberately nothing. Closing the device (or
    // SDL_Quit) joins the audio thread, which never returns if the thread
    // is wedged; the OS reaps the thread and the device at exit.
    let shutdown = () -> void()

    // ------------------------------------------------------------------
    // main thread
    // ------------------------------------------------------------------

    let post = (cmd: sndcmd) ->
        if nosound then return
        let tail = atomic_load_acquire(&ring_tail)
        let head = atomic_load_acquire(&ring_head)
        if tail - head < (i64) ring_size then
            ring[tail % (i64) ring_size] = cmd
            atomic_store_release(&ring_tail, tail + 1i64)

    let simple = (op: i32) -> sndcmd { op = op, slot = 0, handle = 0, id = 0, leftvol = 0, rightvol = 0, step = 0u32, looping = false, tune = default(opl_midi.song) }

    let busy = (k: i32) -> slot_handle[k] != 0 && atomic_load_acquire(&finished[k]) != slot_handle[k]

    let slot_of = (handle: i32) ->
        let mut slot = -1
        for k in 0..num_channels do
            if slot == -1 && slot_handle[k] == handle && busy(k) then slot = k
        slot

    // Doom volumes run 0..15; the mixer's lookup runs 0..127.
    let left_vol = (vol15: i32, sep: i32) -> clamp_vol(vol15 * 8 - ((vol15 * 8 * (sep + 1) * (sep + 1)) >> 16))
    let right_vol = (vol15: i32, sep: i32) -> clamp_vol(vol15 * 8 - ((vol15 * 8 * (sep - 256) * (sep - 256)) >> 16))
    let clamp_vol = (v: i32) -> if v < 0 then 0 else if v > 127 then 127 else v

    // addsfx / I_StartSound
    let start_sound = (id: i32, vol: i32, sep: i32, pitch: i32, priority: i32) ->
        if nosound then return 0
        // Chainsaw troubles: these never stack, a new one replaces the old.
        let mut slot = -1
        if id == sfx.sawup || id == sfx.sawidl || id == sfx.sawful || id == sfx.sawhit
            || id == sfx.stnmov || id == sfx.pistol then
            for k in 0..num_channels do
                if slot == -1 && busy(k) && slot_id[k] == id then slot = k
        // else a free channel, or the oldest one
        if slot == -1 then
            let mut oldest = ds.gametic
            let mut oldestnum = 0
            for k in 0..num_channels do
                if slot == -1 then
                    if !busy(k) then slot = k
                    else if slot_start[k] < oldest then
                        oldestnum = k
                        oldest = slot_start[k]
            if slot == -1 then slot = oldestnum
        handlenums = handlenums + 1
        if handlenums < 100 then handlenums = 100
        let base = (u32) (((i64) sample_rates[id] << 16) / output_rate)
        let step = if pitch_shift then (u32) (((i64) base * steptable[pitch & 255]) >> 16) else base
        slot_handle[slot] = handlenums
        slot_id[slot] = id
        slot_start[slot] = ds.gametic
        post(sndcmd { op = op_start, slot = slot, handle = handlenums, id = id,
                      leftvol = left_vol(vol, sep), rightvol = right_vol(vol, sep), step = step,
                      looping = false, tune = default(opl_midi.song) })
        handlenums

    let stop_sound = (handle: i32) ->
        let slot = slot_of(handle)
        if slot >= 0 then
            let mut cmd = simple(op_stop)
            cmd.slot = slot
            cmd.handle = handle
            post(cmd)
            slot_handle[slot] = 0

    let sound_is_playing = (handle: i32) -> !nosound && slot_of(handle) >= 0

    let update_sound_params = (handle: i32, vol: i32, sep: i32, pitch: i32) ->
        let slot = slot_of(handle)
        if slot >= 0 then
            let mut cmd = simple(op_params)
            cmd.slot = slot
            cmd.handle = handle
            cmd.leftvol = left_vol(vol, sep)
            cmd.rightvol = right_vol(vol, sep)
            post(cmd)

    // I_PlaySong and friends
    let music_play = (data: const u8[], looping: bool) ->
        if nomusic then return
        match musplay.song_for(data) with
        | none -> void()
        | some(tune) ->
            let mut cmd = simple(op_mus_play)
            cmd.tune = tune
            cmd.looping = looping
            post(cmd)
    let music_stop = () -> if !nomusic then post(simple(op_mus_stop))
    let music_pause = () -> if !nomusic then post(simple(op_mus_pause))
    let music_resume = () -> if !nomusic then post(simple(op_mus_resume))
    let music_volume = (v: i32) -> musplay.set_volume(v)

    // ------------------------------------------------------------------
    // audio thread
    // ------------------------------------------------------------------

    let apply = (cmd: sndcmd) ->
        let s = cmd.slot
        if cmd.op == op_start then
            let ch = &chans[s]
            let data = sounds.s_sfx[cmd.id].data
            ch.data = some((const u8*) data.ptr)
            ch.dataend = data.ptr + lengths[cmd.id]
            ch.step = cmd.step
            ch.stepremainder = 0u32
            ch.leftvol = cmd.leftvol
            ch.rightvol = cmd.rightvol
            ch.handle = cmd.handle
        else if cmd.op == op_stop then
            if chans[s].handle == cmd.handle then
                chans[s].data = none(const u8*)
                atomic_store_release(&finished[s], cmd.handle)
        else if cmd.op == op_params then
            if chans[s].handle == cmd.handle then
                chans[s].leftvol = cmd.leftvol
                chans[s].rightvol = cmd.rightvol
        else if cmd.op == op_mus_play then musplay.apply_play(cmd.tune, cmd.looping)
        else if cmd.op == op_mus_stop then musplay.apply_stop()
        else if cmd.op == op_mus_pause then musplay.apply_pause()
        else if cmd.op == op_mus_resume then musplay.apply_resume()

    let drain = () ->
        let mut head = atomic_load_acquire(&ring_head)
        let tail = atomic_load_acquire(&ring_tail)
        loop
            if head >= tail then break
            apply(ring[head % (i64) ring_size])
            head = head + 1i64
        atomic_store_release(&ring_head, head)

    // SDL audio callback: apply the queued commands, mix the effects, add
    // music, write s16 stereo.
    let callback = (userdata: any*?, stream: u8*, len: i32) ->
        drain()
        let frames = len / 4
        let out = i16[] { ptr = (i16*) stream, len = frames * 2 }
        let buf = mix_buf
        for k in 0..frames * 2 do buf[k] = 0
        musplay.render(buf, frames)
        for chn in 0..num_channels do
            let ch = &chans[chn]
            match ch.data with
            | some(start) ->
                let lv = ch.leftvol
                let rv = ch.rightvol
                let mut pos = start
                let mut playing = true
                let mut f = 0
                loop
                    if f >= frames || !playing then break
                    let sample = (i32) *pos - 128
                    // vol_lookup[v*256+j] = v*(j-128)*256/127
                    buf[f * 2] = buf[f * 2] + lv * sample * 256 / 127
                    buf[f * 2 + 1] = buf[f * 2 + 1] + rv * sample * 256 / 127
                    ch.stepremainder = ch.stepremainder + ch.step
                    pos = pos + (i32) (ch.stepremainder >> 16)
                    ch.stepremainder = ch.stepremainder & 0xffffu32
                    if pos >= ch.dataend then
                        playing = false
                        atomic_store_release(&finished[chn], ch.handle)
                    f = f + 1
                ch.data = if playing then some(pos) else none(const u8*)
            | none -> void()
        for k in 0..frames * 2 do
            let s = buf[k]
            out[k] = if s > 0x7fff then 0x7fffi16 else if s < -0x8000 then -0x8000i16 else (i16) s

module snd =
    let s_clipping_dist = 1200 * 0x10000
    let s_close_dist = 160 * 0x10000
    let s_attenuator = (1200 * 0x10000 - 160 * 0x10000) >> 16
    let norm_pitch = 128
    let norm_priority = 64
    let norm_sep = 128
    let s_stereo_swing = 96 * 0x10000

    struct channel =
        sfxinfo: i32      // index into sounds.s_sfx, 0 = free
        origin: const mobj*?    // none: a local sound, heard at full volume
        handle: i32

    let mut channels = default(channel[])
    let mut num_channels = 8
    let mut mus_paused = false
    let mut mus_playing = 0
    let mut nextcleanup = 0
    // -sndtrace: log every sound started or stopped
    let mut trace = false

    let init = (sfx_volume: i32, music_volume: i32) ->
        i.print(alloca("S_Init: default sfx volume %d{sfx_volume}\n"))
        trace = argv.check_parm("-sndtrace") > 0
        isnd.init()
        set_sfx_volume(sfx_volume)
        set_music_volume(music_volume)
        channels = alloc(channel[] { len = num_channels })!
        mus_paused = false
        for k in 1..sfx.numsfx do
            sounds.s_sfx[k].lumpnum = -1
            sounds.s_sfx[k].usefulness = -1

    // Per level startup code. Kills playing sounds at start of level,
    // determines music if any, changes music.
    let spmus = i32[] {
        // Song - Who? - Where?
        mus.e3m4,    // American  e4m1
        mus.e3m2,    // Romero    e4m2
        mus.e3m3,    // Shawn     e4m3
        mus.e1m5,    // American  e4m4
        mus.e2m7,    // Tim       e4m5
        mus.e2m4,    // Romero    e4m6
        mus.e2m6,    // J.Anderson e4m7 CHIRON.WAD
        mus.e2m5,    // Shawn     e4m8
        mus.e1m9     // Tim       e4m9
    }

    let start = () ->
        // kill all playing sounds at start of level
        // (trust me - a good idea)
        for cnum in 0..num_channels do
            if channels[cnum].sfxinfo != 0 then stop_channel(cnum)
        // start new music for the level
        mus_paused = false
        let mnum = if ds.gamemode == gmode.commercial then mus.runnin + ds.gamemap - 1
                   else if ds.gameepisode < 4 then mus.e1m1 + (ds.gameepisode - 1) * 9 + ds.gamemap - 1
                   else spmus[ds.gamemap - 1]
        change_music(mnum, true)
        nextcleanup = 15

    let start_sound_at_volume = (origin: const mobj*?, sfx_id: i32, volume0: i32) ->
        let mut volume = volume0
        // check for bogus sound #
        if sfx_id < 1 || sfx_id > sfx.numsfx then i.fatal(alloca("Bad sfx #: %d{sfx_id}"))
        let sx = &sounds.s_sfx[sfx_id]
        let mut pitch = norm_pitch
        let mut priority = norm_priority
        let mut sep = norm_sep
        // Initialize sound parameters
        if sx.link != -1 then
            pitch = sx.pitch
            priority = sx.priority
            volume = volume + sx.volume
            if volume < 1 then return
            if volume > ds.snd_sfxvolume then volume = ds.snd_sfxvolume
        // Check to see if it is audible, and if not, modify the params
        let listener = ds.players[ds.consoleplayer].mo
        match origin with
        | some(mo) ->
            if !is_listener(listener, mo) then
                let ear = listener!
                let { rc, v2, s2, p2 } = adjust_sound_params(ear, mo, volume, sep, pitch)
                volume = v2
                sep = s2
                pitch = p2
                if mo.x == ear.x && mo.y == ear.y then sep = norm_sep
                if !rc then return
        | none -> void()
        // hacks to vary the sfx pitches
        if sfx_id >= sfx.sawup && sfx_id <= sfx.sawhit then
            pitch = pitch + 8 - (rnd.m_random() & 15)
            if pitch < 0 then pitch = 0
            else if pitch > 255 then pitch = 255
        else if sfx_id != sfx.itemup && sfx_id != sfx.tink then
            pitch = pitch + 16 - (rnd.m_random() & 31)
            if pitch < 0 then pitch = 0
            else if pitch > 255 then pitch = 255
        // kill old sound
        stop_sound_from(origin)
        // try to find a channel
        let cnum = get_channel(origin, sfx_id)
        if cnum < 0 then return
        // get lumpnum if necessary
        if sx.lumpnum < 0 then sx.lumpnum = 0
        // increase the usefulness
        if sx.usefulness < 0 then sx.usefulness = 1 else sx.usefulness = sx.usefulness + 1
        channels[cnum].handle = isnd.start_sound(sfx_id, volume, sep, pitch, priority)
        if trace then i.print(alloca("S %d{ds.gametic} start %s{sx.name} ch=%d{cnum} vol=%d{volume} sep=%d{sep}\n"))

    // Start a sound from a thing (or a sector's sound origin, which shares
    // an mobj's leading fields).
    let start_sound = (origin: const mobj*, sfx_id: i32) ->
        start_sound_at_volume(some(origin), sfx_id, ds.snd_sfxvolume)

    // Start a sound with no position (menus, pickups, full-volume bosses).
    let start_local_sound = (sfx_id: i32) ->
        start_sound_at_volume(none(const mobj*), sfx_id, ds.snd_sfxvolume)

    // Is mo the listening player's own mobj?
    private let is_listener = (listener: const mobj*?, mo: const mobj*) ->
        match listener with
        | some(ear) -> ear == mo
        | none -> false

    // Stop the first sound playing from origin.
    let stop_sound = (origin: const mobj*) -> stop_sound_from(some(origin))

    // Stop the first sound playing from origin, or (none) the first local
    // sound, as S_StopSound(NULL) does.
    private let stop_sound_from = (origin: const mobj*?) ->
        let mut done = false
        for cnum in 0..num_channels do
            if !done && channels[cnum].sfxinfo != 0 && channels[cnum].origin == origin then
                stop_channel(cnum)
                done = true

    // Stop and resume music, during game PAUSE.
    let pause_sound = () ->
        if mus_playing != 0 && !mus_paused then
            isnd.music_pause()
            mus_paused = true

    let resume_sound = () ->
        if mus_playing != 0 && mus_paused then
            isnd.music_resume()
            mus_paused = false

    // Updates music & sounds
    let update_sounds = (listener: const mobj*?) ->
        for cnum in 0..num_channels do
            let ch = &channels[cnum]
            if ch.sfxinfo == 0 then continue
            let sx = &sounds.s_sfx[ch.sfxinfo]
            if isnd.sound_is_playing(ch.handle) then
                // initialize parameters
                let mut volume = ds.snd_sfxvolume
                let mut pitch = norm_pitch
                let mut sep = norm_sep
                if sx.link != -1 then
                    pitch = sx.pitch
                    volume = volume + sx.volume
                    if volume < 1 then
                        stop_channel(cnum)
                        continue
                    else if volume > ds.snd_sfxvolume then
                        volume = ds.snd_sfxvolume
                // check non-local sounds for distance clipping
                // or modify their params
                match ch.origin with
                | some(org) ->
                    if !is_listener(listener, org) then
                        let { rc, v2, s2, p2 } = adjust_sound_params(listener!, org, volume, sep, pitch)
                        if !rc then stop_channel(cnum)
                        else isnd.update_sound_params(ch.handle, v2, s2, p2)
                | none -> void()
            else
                // if channel is allocated but sound has stopped, free it
                stop_channel(cnum)

    let set_music_volume = (volume: i32) ->
        if volume < 0 || volume > 127 then i.fatal(alloca("Attempt to set music volume at %d{volume}"))
        ds.snd_musicvolume = volume
        isnd.music_volume(volume)

    let set_sfx_volume = (volume: i32) ->
        if volume < 0 || volume > 127 then i.fatal(alloca("Attempt to set sfx volume at %d{volume}"))
        ds.snd_sfxvolume = volume

    // Starts some music with the music id found in sounds.h.
    let start_music = (m_id: i32) -> change_music(m_id, false)

    let change_music = (musicnum: i32, looping: bool) ->
        if musicnum <= mus.none_x || musicnum >= mus.nummusic then
            i.fatal(alloca("Bad music number %d{musicnum}"))
        let music = &sounds.s_music[musicnum]
        if mus_playing == musicnum then return
        // shutdown old music
        stop_music()
        // get lumpnum if neccessary
        if music.lumpnum == 0 then
            music.lumpnum = w.get_num_for_name(alloca("d_%s{music.name}"))
        // load & register it
        music.data = u8[] { ptr = w.cache_lump_num(music.lumpnum, pu.music), len = w.lump_length(music.lumpnum) }
        isnd.music_play(music.data, looping)
        mus_playing = musicnum

    let stop_music = () ->
        if mus_playing != 0 then
            if mus_paused then isnd.music_resume()
            isnd.music_stop()
            mus_playing = 0

    let stop_channel = (cnum: i32) ->
        let ch = &channels[cnum]
        if ch.sfxinfo != 0 then
            // stop the sound playing
            if trace then i.print(alloca("S %d{ds.gametic} stop %s{sounds.s_sfx[ch.sfxinfo].name} ch=%d{cnum} playing=%d{if isnd.sound_is_playing(ch.handle) then 1 else 0}\n"))
            if isnd.sound_is_playing(ch.handle) then isnd.stop_sound(ch.handle)
            // degrade usefulness of sound data
            let sx = &sounds.s_sfx[ch.sfxinfo]
            sx.usefulness = sx.usefulness - 1
            ch.sfxinfo = 0

    // Changes volume, stereo-separation, and pitch variables from the norm
    // of a sound effect to be played. If the sound is not audible, returns
    // a 0. Otherwise, modifies parameters and returns 1.
    let adjust_sound_params = (listener: const mobj*, source: const mobj*, vol0: i32, sep0: i32, pitch: i32) ->
        // calculate the distance to sound origin and clip it if necessary
        let adx = fx.iabs(listener.x - source.x)
        let ady = fx.iabs(listener.y - source.y)
        // From _GG1_ p.428. Appox. eucledian distance fast.
        let mut approx_dist = adx + ady - ((if adx < ady then adx else ady) >> 1)
        if ds.gamemap != 8 && approx_dist > s_clipping_dist then
            { false, vol0, sep0, pitch }
        else
            // angle of source to listener
            let mut angle = r.point_to_angle2(listener.x, listener.y, source.x, source.y)
            if angle > listener.angle then angle = angle - listener.angle
            else angle = angle + (0xffffffffu32 - listener.angle)
            let fa = fx.fine(angle)
            // stereo separation
            let sep = 128 - (fx.mul(s_stereo_swing, tables.sin(fa)) >> 16)
            // volume calculation
            let mut vol = 0
            if approx_dist < s_close_dist then
                vol = ds.snd_sfxvolume
            else if ds.gamemap == 8 then
                if approx_dist > s_clipping_dist then approx_dist = s_clipping_dist
                vol = 15 + ((ds.snd_sfxvolume - 15) * ((s_clipping_dist - approx_dist) >> 16)) / s_attenuator
            else
                // distance effect
                vol = (ds.snd_sfxvolume * ((s_clipping_dist - approx_dist) >> 16)) / s_attenuator
            { vol > 0, vol, sep, pitch }

    // S_getChannel: If none available, return -1. Otherwise channel #.
    let get_channel = (origin: const mobj*?, sfxid: i32) ->
        // Find an open channel
        let mut cnum = 0
        loop
            if cnum >= num_channels then break
            if channels[cnum].sfxinfo == 0 then break
            else if origin.is_some && channels[cnum].origin == origin then
                stop_channel(cnum)
                break
            cnum = cnum + 1
        // None available
        if cnum == num_channels then
            // Look for lower priority
            cnum = 0
            loop
                if cnum >= num_channels then break
                if sounds.s_sfx[channels[cnum].sfxinfo].priority >= sounds.s_sfx[sfxid].priority then break
                cnum = cnum + 1
            if cnum == num_channels then
                // FUCK!  No lower priority.  Sorry, Charlie.
                cnum = -1
            else
                // Otherwise, kick out lower priority.
                stop_channel(cnum)
        if cnum >= 0 then
            let ch = &channels[cnum]
            ch.sfxinfo = sfxid
            ch.origin = origin
        cnum
